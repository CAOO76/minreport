{
    "gradle.nestedProjects": [],
    "java.gradle.buildServer.enabled": "off",
    "java.import.gradle.enabled": false,
    "java.jdt.ls.java.home": "/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
    "java.configuration.updateBuildConfiguration": "disabled",
    "java.import.gradle.wrapper.enabled": true,
    "java.import.gradle.java.home": "/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-17",
            "path": "/usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home",
            "default": true
        },
        {
            "name": "JavaSE-21",
            "path": "/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
        }
    ],
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/dist/**",
        "**/web/dist/**",
        "**/web/android/**"
    ],
    "files.exclude": {
        "**/node_modules/@capacitor/**/android/bin": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/web/android/.gradle/**": true,
        "**/web/android/app/build/**": true,
        "**/data/**": true,
        "**/_backups/**": true,
        "**/*.log": true
    },
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.smoothScrolling": false
}
