# ==============================================================================
# MINREPORT — CONFIGURACIÓN SOBERANA DE VARIABLES DE ENTORNO (.env.example)
# Región Obligatoria: southamerica-west1 (Santiago, Chile)
# Cumplimiento Ley N° 19.628, Nueva Ley N° 21.719 e ISO/IEC 27001
# ==============================================================================

NODE_ENV=development
PORT=8080
GCP_PROJECT_ID=minreport-8f2a8
GCP_LOCATION=southamerica-west1

# ------------------------------------------------------------------------------
# CAPA 4 — ENJAMBRE GEMINI AI & RECURSOS GOOGLE AI ULTRA (Paid-Tier CDPA)
# Las llaves reales residen en Google Cloud Secret Manager (southamerica-west1)
# o en .env.local (ignorado por Git).
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_DEV_API_KEY=

# Modelos del Enjambre Jerárquico (Google AI Ultra / Gemini 4 Argon + 3.x)
PREMIUM_GEMINI_MODEL=gemini-4-argon
FALLBACK_GEMINI_MODEL=gemini-3.8-flash
LITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Generación Gráfica Técnica (Nano Banana Pro + Imagen 4.0)
IMAGEN_PRIMARY_MODEL=gemini-3-pro-image
NANO_BANANA_PRO_MODEL=gemini-nano-banana-2.1
IMAGEN_FALLBACK_MODEL=imagen-4.0-generate-001

# Embeddings Semánticos Matryoshka (768d)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# FRONTEND VITE (Públicas de Cliente Firebase — Cero Secretos de Servidor)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=minreport-8f2a8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=minreport-8f2a8
VITE_FIREBASE_STORAGE_BUCKET=minreport-8f2a8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=493995072778
VITE_FIREBASE_APP_ID=
VITE_API_URL=http://localhost:8080

