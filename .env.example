# ==============================================================================
# MINREPORT — CONFIGURACIÓN SOBERANA DE VARIABLES DE ENTORNO (.env.example)
# Región Obligatoria: southamerica-west1 (Santiago, Chile)
# Cumplimiento Ley N° 19.628, Nueva Ley N° 21.719 e ISO/IEC 27001
# ==============================================================================

NODE_ENV=development
PORT=8080
GCP_PROJECT_ID=minreport-8f2a8
GCP_LOCATION=southamerica-west1

# ------------------------------------------------------------------------------
# CAPA 4 — ENJAMBRE GEMINI AI & VERTEX AI CDPA (southamerica-west1)
# Las llaves reales residen exclusivamente en Google Cloud Secret Manager
# (southamerica-west1) o en .env.local (ignorado por Git).
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_DEV_API_KEY=
USE_VERTEX_AI=

# Modelos del Enjambre Jerárquico (Gemini 3.x — Defaults verificados en resilient-ai-client.ts)
PREMIUM_GEMINI_MODEL=gemini-3.1-pro-preview
FALLBACK_GEMINI_MODEL=gemini-3-flash-preview
LITE_GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Generación Gráfica Técnica (Nano Banana Pro + Imagen 4.0)
IMAGEN_PRIMARY_MODEL=gemini-3-pro-image
NANO_BANANA_PRO_MODEL=gemini-nano-banana-2.1
IMAGEN_FALLBACK_MODEL=imagen-4.0-generate-001

# Embeddings Semánticos Matryoshka (768d)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# CAPA 3 — MONETIZACIÓN AGÉNTICA M2M (Protocolo x402 Foundation)
# Secretos reales exclusivos en Cloud Secret Manager (southamerica-west1).
# ------------------------------------------------------------------------------
X402_HMAC_SECRET=
X402_TREASURY_ACCOUNT=

# ------------------------------------------------------------------------------
# MINREPORT · ABASTECIMIENTO — COLA CLOUD TASKS & META WHATSAPP CLOUD API
# Todos los tokens, llaves privadas RSA de Flows y allowlists DEV residen
# exclusivamente en Google Cloud Secret Manager (southamerica-west1).
# NUNCA escribir credenciales ni teléfonos reales en este archivo versionado.
# ------------------------------------------------------------------------------
# Cola Cloud Tasks regional en southamerica-west1 (default código: supply-whatsapp-queue)
SUPPLY_CLOUD_TASKS_QUEUE=

# Activación controlada en etapa privada DEV_PRIVATE (fail-closed por defecto)
SUPPLY_WHATSAPP_DEV_ENABLED=
# CSV de teléfonos E.164 autorizados para pruebas DEV (reside en Secret Manager southamerica-west1)
SUPPLY_WHATSAPP_DEV_ALLOWLIST=

# Credenciales Meta WhatsApp Cloud API (residen en Secret Manager southamerica-west1)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Llaves criptográficas WhatsApp Flows v3.0 (RSA-2048 + AES-128-GCM, Secret Manager southamerica-west1)
WHATSAPP_FLOWS_PRIVATE_KEY=
WHATSAPP_FLOWS_PASSPHRASE=

# ------------------------------------------------------------------------------
# FRONTEND VITE (Públicas de Cliente Firebase — Cero Secretos de Servidor)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=minreport-8f2a8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=minreport-8f2a8
VITE_FIREBASE_STORAGE_BUCKET=minreport-8f2a8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=493995072778
VITE_FIREBASE_APP_ID=
VITE_API_URL=http://localhost:8080

