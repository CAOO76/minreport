    // Calibración geométrica on-demand por dispositivo y faena (R5 — Aislamiento Multi-Tenant, Append-Only cliente)
    match /device_calibrations/{calId} {
      allow read: if isAuthenticated() && (isSystemPrivileged() || canReadTenantDoc(resource.data));
      allow create: if isAuthenticated() &&
        isBoundedPayload(request.resource.data) &&
        isValidDeviceCalibrationPayload(request.resource.data) &&
