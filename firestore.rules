rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verify if user is a Super Admin
    function isSuperAdmin() {
      return request.auth != null && 
        (
          request.auth.token.role == 'SUPER_ADMIN' ||
          request.auth.token.email == 'admin@minreport.com'
        );
    }

    // Helper: Check if user belongs to an account
    function isAccountMember(accountId) {
      return request.auth != null && (
        isSuperAdmin() ||
        request.auth.token.activeAccountId == accountId ||
        get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid
      );
    }

    // SEGURIDAD BANCARIA: Prohibida lectura pública de RUTs
    // Solo usuarios autenticados autorizados o Super Admins pueden consultar
    match /user_directory/{run} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Perfiles de usuario (Lectura restringida al propio UID)
    match /users/{userId} {
      allow read, write: if isSuperAdmin();
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 1;
      allow update: if request.auth != null && request.auth.uid == userId && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAccountId', 'memberships', 'notificationsSettings']);
      allow delete: if isSuperAdmin();
    }

    // CUENTAS Y ESPACIOS DE TRABAJO TITULARES B2B
    match /accounts/{accountId} {
      allow get: if isAccountMember(accountId);
      allow list: if request.auth != null && (
        isSuperAdmin() || 
        resource.data.ownerId == request.auth.uid ||
        (resource.data.primaryOperator != null && resource.data.primaryOperator.email == request.auth.token.email)
      );
      allow create: if request.auth != null; // Creado por registro titular B2B
      allow delete: if isSuperAdmin();
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.ownerId == request.auth.uid) ||
        (request.auth.token.activeAccountId == accountId)
      );

      // Subcolección: Perfiles de Cargo (Job Profiles)
      match /job_profiles/{profileId} {
        allow read, write: if isAccountMember(accountId);
      }

      // Subcolección: Miembros Internos
      match /members/{memberId} {
        allow read, write: if isAccountMember(accountId);
      }
    }

    // [CAPA 3] AUDIT LEDGER INMUTABLE (Append-Only)
    match /audit_ledger/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isAccountMember(resource.data.tenantId);
      allow update, delete: if false; // Prohibida cualquier modificación (Inmutable)
    }

    // [OPERMAQ] Flota y Pautas de Inspección DS 132
    match /machinery_fleet/{assetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAccountMember(request.resource.data.tenantId);
    }
    // [OPERMAQ] Inspecciones de Flota
    match /inspections/{inspectionId} {
      allow read, write: if request.auth != null;
    }
    match /fleet_inspections/{inspectionId} {
      allow read, write: if request.auth != null;
    }

    // [STOCKPILE] Acopios Topográficos y Volumetría
    match /stockpiles/{stkId} {
      allow read, write: if request.auth != null;
    }

    // [MINING FLOW] Eventos Financieros y Flujo de Caja
    match /financial_events/{eventId} {
      allow read, write: if request.auth != null;
    }
    match /financial_ledger/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // Inmutable
    }

    // Configuración Global y Branding
    match /settings/branding {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Solicitudes Educacionales (Edu Gatekeeper)
    match /tenants/{tenantId} {
      allow read, write: if isSuperAdmin();
      allow create: if request.auth != null;
    }
    match /edu_whitelists/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Mensajería y Notificaciones
    match /users/{userId}/inbox/{messageId} {
      allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Módulos y Plugins
    match /plugins/{pluginId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
  }
}
