          (docTenantId(request.resource.data) is string && isAccountMember(docTenantId(request.resource.data)))
        );
      allow update: if isAuthenticated() &&
        isBoundedPayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          (
            docTenantId(resource.data) is string &&
            isAccountMember(docTenantId(resource.data)) &&
            docTenantId(request.resource.data) == docTenantId(resource.data)
          )
        );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (docTenantId(resource.data) is string && isTenantAdminOrOwner(docTenantId(resource.data)))
      );
    }

    // Solicitudes operativas de onboarding de equipos (Lectura multi-tenant/privilegiada; escritura exclusiva Admin SDK)
    match /equipment_onboarding_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        isAdmin() ||
        canReadTenantDoc(resource.data)
      );
      allow write: if false;
    }

    // ===============================================================
    // 8. Plan Maestro v4.0 — Catálogo Global, CAS, Bóvedas y Benchmark
    // ===============================================================

    match /global_asset_catalog/{assetId} {
      allow read: if isAuthenticated();
      // Segregación estricta GEMINI.md §1.1: 2º ADMIN mantiene lectura comercial; mutación directa cliente OEM exclusiva 1º DEV y 3º TEST-PILOT
      allow create, update: if (isDevRoot() || isTestPilot()) && isValidOpermaqPayload(request.resource.data);
      allow delete: if isDevRoot();

      // Particionamiento Anti-1MiB OPERMAQ v3.0: Pilares técnicos del activo OEM
      match /pillars/{pillarId} {
        allow read: if isAuthenticated();
        allow create, update: if (isDevRoot() || isTestPilot()) && isValidOpermaqPayload(request.resource.data);
        allow delete: if isDevRoot();
      }

      // Particionamiento Anti-1MiB OPERMAQ v3.0: Historial inmutable append-only de versiones de capítulos
      match /item_revisions/{revId} {
        allow read: if isSystemPrivileged();
        allow create: if (isDevRoot() || isTestPilot()) && isValidOpermaqPayload(request.resource.data);
        allow update, delete: if false;
      }

      // Particionamiento Anti-1MiB OPERMAQ v3.0: Artefactos derivados (cost_matrix, symbology_pack, etc.)
      match /derived/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if isDevRoot();
      }

      match /vault_chats/{itemId}/sessions/{sessionId} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /vault_files/{fileHash} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /vault_corpus_chunks/{chunkId} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /ingestion_jobs/{jobId} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /generated_manuals/{manualId} {
        allow read: if isAuthenticated();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }
    }

    // Diccionario maestro auto-aprendido de esquemas técnicos por TIPO de equipo (OPERMAQ)
    match /global_equipment_types/{typeId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isDevRoot();
    }

    // Manifiestos colaborativos de linaje y versiones de modelos (OPERMAQ)
    match /global_asset_lineages/{lineageId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isDevRoot();
    }

    match /master_symbology_vault/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isBoundedPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /task_status/{taskId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /vault_corpus_files/{fileId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /vault_assist_sessions/{sessionId} {
      allow read: if isSystemPrivileged();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /benchmark_events/{eventId} {
      allow read: if isSystemPrivileged();
      allow create: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() && (
            (
              docTenantId(request.resource.data) is string &&
              isAccountMember(docTenantId(request.resource.data))
            ) ||
            (
              !('tenantId' in request.resource.data) &&
              !('tenant_id' in request.resource.data) &&
              !('accountId' in request.resource.data) &&
              'tenantHash' in request.resource.data &&
              request.resource.data.tenantHash is string &&
              request.resource.data.tenantHash.size() >= 32 &&
              request.resource.data.tenantHash.size() <= 128
            )
          )
        )
      );
      allow update: if isAdmin() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    match /benchmark_insights/{insightId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /knowledge_contributions/{contribId} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        ('authorUid' in resource.data && resource.data.authorUid == request.auth.uid) ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isAuthenticated() &&
        isValidOpermaqPayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          (
            (!('authorUid' in request.resource.data) || request.resource.data.authorUid == null || request.resource.data.authorUid == request.auth.uid) &&
            (docTenantId(request.resource.data) == null || isAccountMember(docTenantId(request.resource.data))) &&
            (!('status' in request.resource.data) || request.resource.data.status == 'PENDING_HUMAN_REVIEW') &&
            (!('estado_aprobacion' in request.resource.data) || request.resource.data.estado_aprobacion == 'BORRADOR_IA')
          )
        );
      allow update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /media_registry/{sha256} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        ('scope' in resource.data && resource.data.scope in ['GLOBAL_OEM', 'SYMBOLOGY_MASTER']) ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() &&
          docTenantId(request.resource.data) is string &&
          isAccountMember(docTenantId(request.resource.data)) &&
          (!('scope' in request.resource.data) || request.resource.data.scope == 'TENANT_PRIVATE')
        )
      );
      allow update: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() &&
          docTenantId(resource.data) is string &&
          isAccountMember(docTenantId(resource.data)) &&
          docTenantId(request.resource.data) == docTenantId(resource.data) &&
          (!('scope' in request.resource.data) || request.resource.data.scope == 'TENANT_PRIVATE')
        )
      );
      allow delete: if isAdmin();
    }

    match /commons_airlock_queue/{queueId} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isAuthenticated() &&
        isValidOpermaqPayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          (docTenantId(request.resource.data) is string && isAccountMember(docTenantId(request.resource.data)))
        );
      allow update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /global_material_catalog/{materialId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /symbology_review_queue/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    // ===============================================================
    // 8.1 OPERMAQ · FABRICANTES — Modelo Unificado y Aportes Comunitarios
    // ===============================================================

    // Maestra global de fabricantes Zero-Preset (mutación exclusiva Admin SDK tras HITL "ACTUALIZAR" + AuditLedger)
    match /global_manufacturers/{manufacturerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Entidad comercial única multimarca con representations[] unificadas (mutación exclusiva Admin SDK / HITL "ACTUALIZAR")
    match /global_suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Legado sellado (modelo unificado en /global_suppliers.representations[])
    match /supplier_channel_rules/{ruleId} {
      allow read, write: if false;
    }

    // Cola de aportes comunitarios moderados bajo Ley N° 19.628 / N° 21.719 (lectura exclusiva 1º DEV / 2º ADMIN; recepción backend ConfidentialityAirlockService + bloqueo 5º EDU)
    match /supplier_contact_contributions/{contributionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===============================================================
    // 9. Colecciones Legacy Blindadas (Lectura Auth, Escritura Privilegiada)
    // ===============================================================

    match /equipment_manuals/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /operational_guides/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /preventive_maintenance/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /risk_matrices/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /pre_operational_checklists/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /global_symbology/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    // ===============================================================
    // Bloque Atómico 3.2 — Núcleo Geoespacial Multi-Dispositivo
    // ===============================================================

    // Caché determinista SHA-256 de geocodificación directa/inversa (Cloud Run / Admin SDK, expiresAt TTL 30 días)
    match /geo_resolve_cache/{cacheKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sellos georreferenciados auditables inmutables (POST /api/geo/report-stamp; accountId / tenantId, stampHashSha256, retención legal 6 años)
    match /geo_report_stamps/{stampId} {
      allow read: if isAdmin() || (isAuthenticated() && canReadTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 10. Default Deny Raíz (Cierre Total ISO 27001)
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
