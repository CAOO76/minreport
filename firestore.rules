rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Verify if user is a Super Admin
    function isSuperAdmin() {
      return request.auth != null && 
        (
          request.auth.token.role == 'SUPER_ADMIN' ||
          request.auth.token.email == 'admin@minreport.com'
          // Removed database lookup to prevent circular dependency/recursion loops on user profile reads
        );
    }

    // User Directory (Public lookup by RUN for login flow)
    match /user_directory/{run} {
      allow read: if true; // Needed to identify user by RUT before auth
      allow write: if isSuperAdmin() || 
        (request.auth != null && (
          (request.resource.data.accountId != null && get(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.ownerId == request.auth.uid) ||
          (resource != null && resource.data.accountId != null && get(/databases/$(database)/documents/accounts/$(resource.data.accountId)).data.ownerId == request.auth.uid)
        ));
      // Allow delete for authenticated users (E2E cleanup)
      allow delete: if request.auth != null;
    }

    // User Profiles Collection
    match /users/{userId} {
      // Super Admins can do everything
      allow read, write: if isSuperAdmin();
      
      // Regular users can only read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // [LOGIN FLOW SUPPORT] Allow looking up a user by email (Limit 1)
      allow list: if request.query.limit != null && request.query.limit <= 1; 
      
      // Allow users to update their own LAST ACTIVE ACCOUNT only (context switching)
      allow update: if request.auth != null && request.auth.uid == userId && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAccountId', 'memberships', 'notificationsSettings']);
      
      // Allow delete for authenticated users (E2E cleanup)
      allow delete: if request.auth != null;
    }

    // ACCOUNTS / TENANTS DATA
    match /accounts/{accountId} {
      // Allow reading specific document if Owner, Operator, Super Admin OR Active Session
      allow get: if request.auth != null && (
        isSuperAdmin() ||
        // Trust the Custom Token Claim (Tunnel-validated access)
        request.auth.token.activeAccountId == accountId ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.primaryOperator != null && resource.data.primaryOperator.email == request.auth.token.email)
      );

      // [CRITICAL] Allow LIST queries for Login/Invitation flow
      allow list: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.ownerId == request.auth.uid) || 
        (resource.data.primaryOperator != null && resource.data.primaryOperator.email == request.auth.token.email)
      );

      // Only Super Admin can CREATE/DELETE accounts
      allow create, delete: if isSuperAdmin();

      // Update rules: Super Admin OR Owner OR Primary Operator (for accepting invite)
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        // Owner: Can update operator invite and basic info
        (resource.data.ownerId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primaryOperator', 'name', 'description', 'settings', 'updatedAt'])) ||
        // Operator: Can update their own status (accept invite)
        (resource.data.primaryOperator != null && resource.data.primaryOperator.email == request.auth.token.email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primaryOperator', 'updatedAt']))
      );

      // [NEW] Job Profiles Subcollection
      match /job_profiles/{profileId} {
        allow read, write: if request.auth != null && (
          isSuperAdmin() ||
          request.auth.token.activeAccountId == accountId ||
          get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid
        );
      }

      // [NEW] Members Subcollection
      match /members/{memberId} {
        allow read: if request.auth != null && (
          isSuperAdmin() ||
          request.auth.token.activeAccountId == accountId ||
          request.auth.uid == memberId
        );
        allow write: if request.auth != null && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid
        );
      }
    }

    // Audit Logs Collection (Append Only for Admin)
    match /admin_audit_logs/{logId} {
      allow create, read: if isSuperAdmin();
    }

    // Branding & Global Settings
    match /settings/branding {
      allow read: if true; // Publicly readable for UI consistency
      allow write: if isSuperAdmin();
    }

    // Tenants Management (Requests)
    match /tenants/{tenantId} {
      allow read, write: if isSuperAdmin();
    }

    // User Inbox (Messages)
    match /users/{userId}/inbox/{messageId} {
      allow read, write: if isSuperAdmin();
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // System Plugins (Dynamic Registry)
    match /plugins/{pluginId} {
      allow read: if request.auth != null; // Authenticated users/admins can read
      allow write: if isSuperAdmin();      // Only Super Admin can manage plugins
    }

    // SDK Versions Management
    match /admin_sdk_versions/{versionId} {
      allow read, write: if isSuperAdmin();
    }

    // [NEW] System Emails (Mailbox Mock for E2E)
    match /system_emails/{emailId} {
      allow read: if request.auth != null; // Needed for E2E tests to pick up activation links
      allow write: if isSuperAdmin();
    }
  }
}
