        allow delete: if isDevRoot();
      }

      // Particionamiento Anti-1MiB OPERMAQ v3.0: Historial inmutable append-only de versiones de capítulos
      match /item_revisions/{revId} {
        allow read: if isSystemPrivileged();
        allow create: if isDevRoot() && isValidOpermaqPayload(request.resource.data);
        allow update, delete: if false;
      }

      // Particionamiento Anti-1MiB OPERMAQ v3.0: Artefactos derivados (cost_matrix, symbology_pack, etc.)
      match /derived/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if isDevRoot();
      }

      match /vault_chats/{itemId}/sessions/{sessionId} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /vault_files/{fileHash} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /vault_corpus_chunks/{chunkId} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /ingestion_jobs/{jobId} {
        allow read: if isSystemPrivileged();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }

      match /generated_manuals/{manualId} {
        allow read: if isAuthenticated();
        allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
        allow delete: if canCurateOpermaq();
      }
    }

    // Diccionario maestro auto-aprendido de esquemas técnicos por TIPO de equipo (OPERMAQ)
    match /global_equipment_types/{typeId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isDevRoot();
    }

    // Manifiestos colaborativos de linaje y versiones de modelos (OPERMAQ)
    match /global_asset_lineages/{lineageId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isDevRoot();
    }

    match /master_symbology_vault/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isBoundedPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /task_status/{taskId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /vault_corpus_files/{fileId} {
      allow read: if isAuthenticated();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /vault_assist_sessions/{sessionId} {
      allow read: if isSystemPrivileged();
      allow create, update: if canCurateOpermaq() && isValidOpermaqPayload(request.resource.data);
      allow delete: if canCurateOpermaq();
    }

    match /benchmark_events/{eventId} {
      allow read: if isSystemPrivileged();
      allow create: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() && (
            (
              docTenantId(request.resource.data) is string &&
              isAccountMember(docTenantId(request.resource.data))
            ) ||
            (
              !('tenantId' in request.resource.data) &&
              !('tenant_id' in request.resource.data) &&
              !('accountId' in request.resource.data) &&
              'tenantHash' in request.resource.data &&
              request.resource.data.tenantHash is string &&
              request.resource.data.tenantHash.size() >= 32 &&
              request.resource.data.tenantHash.size() <= 128
            )
          )
        )
      );
      allow update: if isAdmin() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    match /benchmark_insights/{insightId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /knowledge_contributions/{contribId} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        ('authorUid' in resource.data && resource.data.authorUid == request.auth.uid) ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isAuthenticated() &&
        isValidOpermaqPayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          (
            (!('authorUid' in request.resource.data) || request.resource.data.authorUid == null || request.resource.data.authorUid == request.auth.uid) &&
            (docTenantId(request.resource.data) == null || isAccountMember(docTenantId(request.resource.data))) &&
            (!('status' in request.resource.data) || request.resource.data.status == 'PENDING_HUMAN_REVIEW') &&
            (!('estado_aprobacion' in request.resource.data) || request.resource.data.estado_aprobacion == 'BORRADOR_IA')
          )
        );
      allow update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /media_registry/{sha256} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        ('scope' in resource.data && resource.data.scope in ['GLOBAL_OEM', 'SYMBOLOGY_MASTER']) ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() &&
          docTenantId(request.resource.data) is string &&
          isAccountMember(docTenantId(request.resource.data)) &&
          (!('scope' in request.resource.data) || request.resource.data.scope == 'TENANT_PRIVATE')
        )
      );
      allow update: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() &&
          docTenantId(resource.data) is string &&
          isAccountMember(docTenantId(resource.data)) &&
          docTenantId(request.resource.data) == docTenantId(resource.data) &&
          (!('scope' in request.resource.data) || request.resource.data.scope == 'TENANT_PRIVATE')
        )
      );
      allow delete: if isAdmin();
    }

    match /commons_airlock_queue/{queueId} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isAuthenticated() &&
        isValidOpermaqPayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          (docTenantId(request.resource.data) is string && isAccountMember(docTenantId(request.resource.data)))
        );
      allow update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /global_material_catalog/{materialId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /symbology_review_queue/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    // ===============================================================
    // 8.1 OPERMAQ · FABRICANTES — Modelo Unificado y Aportes Comunitarios
    // ===============================================================

    // Maestra global de fabricantes Zero-Preset (mutación exclusiva Admin SDK tras HITL "ACTUALIZAR" + AuditLedger)
    match /global_manufacturers/{manufacturerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Entidad comercial única multimarca con representations[] unificadas (mutación exclusiva Admin SDK / HITL "ACTUALIZAR")
    match /global_suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Legado sellado (modelo unificado en /global_suppliers.representations[])
    match /supplier_channel_rules/{ruleId} {
      allow read, write: if false;
    }

    // Cola de aportes comunitarios moderados bajo Ley N° 19.628 / N° 21.719 (lectura exclusiva 1º DEV / 2º ADMIN; recepción backend ConfidentialityAirlockService + bloqueo 5º EDU)
    match /supplier_contact_contributions/{contributionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===============================================================
    // 8.2 MINREPORT · ABASTECIMIENTO (`moduleId: 'supply'` — Base Única southamerica-west1)
    // ===============================================================
    // Nota: `/global_suppliers/{supplierId}` ya está protegido en §8.1 (`allow read: if isAuthenticated(); allow write: if false;`)
    // y `/modules_status/{moduleId}` en §4 soporta `modules_status/supply` de forma nativa.

    // --- 8.2.1 Global Commons / Catálogo Maestro y Presets de Políticas ---

    // Catálogo maestro global de SKUs de abastecimiento (aislamiento estricto de SKUs privados con tenantId o scope=='TENANT_PRIVATE';
    // docs globales públicos legibles por cuentas activas; docs privados exclusivos isAdmin o miembros activos del mismo tenantId;
    // escritura exclusiva 1º DEV / 2º ADMIN con validador anti-PII y sin tenantId no controlado)
    match /global_supply_catalog/{skuId} {
      allow read: if isAdmin() || (
        isActiveAuthenticatedUser() &&
        resource != null &&
        (
          isGlobalSupplyCatalogPublicDoc(resource.data) ||
          canReadSupplyTenantDoc(resource.data)
        )
      );
      allow create: if (isDevRoot() || isSuperAdmin()) &&
        isValidGlobalSupplyCatalogPayload(request.resource.data, skuId);
      allow update: if (isDevRoot() || isSuperAdmin()) &&
        isGlobalSupplyCatalogPublicDoc(resource.data) &&
        isValidGlobalSupplyCatalogPayload(request.resource.data, skuId) &&
        (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!('skuId' in resource.data) || !('skuId' in request.resource.data) || request.resource.data.skuId == resource.data.skuId) &&
        (!('canonicalSkuId' in resource.data) || !('canonicalSkuId' in request.resource.data) || request.resource.data.canonicalSkuId == resource.data.canonicalSkuId);
      allow delete: if isDevRoot() || isSuperAdmin();
    }

    // Presets globales de políticas y topes de aprobación por rol (lectura autenticada activa; escritura exclusiva 1º DEV / 2º ADMIN con validador)
    match /global_supply_policy_presets/{roleId} {
      allow read: if isAdmin() || isActiveAuthenticatedUser();
      allow create: if (isDevRoot() || isSuperAdmin()) &&
        isValidGlobalSupplyPolicyPresetPayload(request.resource.data, roleId);
      allow update: if (isDevRoot() || isSuperAdmin()) &&
        isValidGlobalSupplyPolicyPresetPayload(request.resource.data, roleId) &&
        (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        (!('roleId' in resource.data) || !('roleId' in request.resource.data) || request.resource.data.roleId == resource.data.roleId);
      allow delete: if isDevRoot() || isSuperAdmin();
    }

    // --- 8.2.2 Colecciones Sensibles / Privacidad Ley N° 21.719 / Auditoría de Políticas ---

    // Sesiones conversacionales WhatsApp (hashes telefónicos y estado efímero — Ley N° 21.719; exclusivo Admin SDK)
    match /supply_whatsapp_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Guardia atómica de idempotencia WhatsApp WAMID (exclusivo Admin SDK)
    match /supply_whatsapp_wamids/{wamid} {
      allow read, write: if false;
    }

    // Auditoría de políticas de abastecimiento (lectura tenant-scoped exclusiva OWNER/ADMIN ACTIVO o DEV_ROOT/SUPER_ADMIN; escritura exclusiva Admin SDK)
    match /supply_policy_audit/{eventId} {
      allow read: if isAdmin() || (isActiveAuthenticatedUser() && resource != null && canReadSupplyPolicyAuditDoc(resource.data));
      allow write: if false;
    }

    // --- 8.2.3 Señales Anónimas de Demanda Marketplace (Ley N° 21.719 k>=3) ---

    // Señales agregadas anónimas generadas exclusivamente por backend Admin SDK tras agregación k>=3 (sin tenantId ni GPS)
    match /market_demand_signals/{signalId} {
      allow read: if isAdmin() || isActiveAuthenticatedUser();
      allow write: if false;
    }

    // --- 8.2.4 Colecciones Operativas y Ledgers Multi-Tenant (Server-Authoritative vía `/api/supply/*` Admin SDK) ---
    // Todas portan `tenantId`: lectura aislada por tenant (miembro directo B2B/EDU, 1º DEV / 2º ADMIN, o 3º TEST-PILOT
    // hermético a su propio sandbox `pilot-*`); toda mutación cliente bloqueada (`create, update, delete == false`) para
    // garantizar contratos Zod, AuditLedger SHA-256, MediaDigestorServer CAS, anti-duplicación SII y HITL "ACTUALIZAR".

    match /tenant_suppliers/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    match /supply_sites/{siteId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    match /supply_warehouses/{whId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    match /supply_inventory_items/{itemId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    match /supply_requisitions/{reqId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;

      // Subcolección de líneas de requerimiento (bloquea acceso a subcolecciones huérfanas validando existencia y tenant del padre)
      match /lines/{lineId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          exists(/databases/$(database)/documents/supply_requisitions/$(reqId)) &&
          canReadSupplyTenantDoc(get(/databases/$(database)/documents/supply_requisitions/$(reqId)).data)
        );
        allow create, update, delete: if false;
      }
    }

    match /supply_requisition_lines/{lineId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    match /supply_purchases/{purchaseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;

      // Subcolección de líneas de orden de compra (bloquea acceso a subcolecciones huérfanas validando existencia y tenant del padre)
      match /lines/{lineId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          exists(/databases/$(database)/documents/supply_purchases/$(purchaseId)) &&
          canReadSupplyTenantDoc(get(/databases/$(database)/documents/supply_purchases/$(purchaseId)).data)
        );
        allow create, update, delete: if false;
      }
    }

    match /supply_purchase_lines/{lineId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // Ledger append-only de asignaciones/cumplimiento (mutación exclusiva Admin SDK)
    match /supply_fulfillment_allocations/{allocId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    match /supply_assets/{assetId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // Ledger append-only de movimientos de inventario/stock (mutación exclusiva Admin SDK)
    match /supply_stock_ledger/{movId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // Ledger append-only de movimientos de caja/fondos por rendir (mutación exclusiva Admin SDK)
    match /supply_cash_ledger/{cashMovId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // Documentos tributarios SII (mutación exclusiva Admin SDK para preservar llave anti-duplicación `rut#tipo#folio` y AuditLedger)
    match /supply_sii_documents/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // Rendiciones de gastos (mutación exclusiva Admin SDK con gate HITL vía `/api/supply/sii/expense-reports`)
    match /supply_expense_reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // Pronósticos de demanda computados en servidor (mutación exclusiva Admin SDK)
    match /supply_demand_forecasts/{forecastId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && canReadSupplyTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 9. Colecciones Legacy Blindadas (Lectura Auth, Escritura Privilegiada)
    // ===============================================================

    match /equipment_manuals/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /operational_guides/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /preventive_maintenance/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /risk_matrices/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /pre_operational_checklists/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /global_symbology/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    // ===============================================================
    // Bloque Atómico 3.2 — Núcleo Geoespacial Multi-Dispositivo
    // ===============================================================

    // Caché determinista SHA-256 de geocodificación directa/inversa (Cloud Run / Admin SDK, expiresAt TTL 30 días)
    match /geo_resolve_cache/{cacheKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sellos georreferenciados auditables inmutables (POST /api/geo/report-stamp; accountId / tenantId, stampHashSha256, retención legal 6 años)
    match /geo_report_stamps/{stampId} {
      allow read: if isAdmin() || (isAuthenticated() && canReadTenantDoc(resource.data));
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 10. Default Deny Raíz (Cierre Total ISO 27001)
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
