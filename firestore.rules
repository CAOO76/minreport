        (docTenantId(resource.data) is string && isTenantAdminOrOwner(docTenantId(resource.data)))
      );
    }

    match /stockpiles/{stkId} {
      allow read: if isAuthenticated() && (isSystemPrivileged() || canReadTenantDoc(resource.data));
      allow create: if isAuthenticated() &&
        isValidStockpilePayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          isTenantMatchCreate(request.resource.data)
        );
      allow update: if isAuthenticated() &&
        isValidStockpilePayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          isTenantMatchUpdate(resource.data, request.resource.data)
        );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (docTenantId(resource.data) is string && isTenantAdminOrOwner(docTenantId(resource.data)))
      );

      // Subcolección de mediciones STOCKPILE CONTROL Next-Gen aislada por tenant propio y del acopio padre
      match /measurements/{measId} {
        allow read: if isAuthenticated() && (
          isSystemPrivileged() ||
          canReadTenantDoc(resource.data) ||
          (
            exists(/databases/$(database)/documents/stockpiles/$(stkId)) &&
            canReadTenantDoc(get(/databases/$(database)/documents/stockpiles/$(stkId)).data)
          )
        );
        allow create: if isAuthenticated() &&
          isValidStockpileMeasurementPayload(request.resource.data) &&
          (
            isSystemPrivileged() ||
            isMeasurementCreateTenantValid(stkId, request.resource.data)
          );
        allow update: if isAuthenticated() &&
          isValidStockpileMeasurementPayload(request.resource.data) &&
          (
            isSystemPrivileged() ||
            isTenantMatchUpdate(resource.data, request.resource.data)
          );
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          (docTenantId(resource.data) is string && isTenantAdminOrOwner(docTenantId(resource.data)))
        );
      }
