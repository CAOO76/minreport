rules_version = '2';

// ===============================================================
// MINREPORT Web 3.0 — Seguridad Bancaria Multi-Tenant (ISO 27001)
// Jerarquía Soberana de 5 Tipos de Cuenta:
//   1º DEV          (isDevRoot        — DEV_ROOT / dev@minreport.com verificado)
//   2º ADMIN        (isSuperAdmin     — SUPER_ADMIN / admin@minreport.com verificado)
//   3º TEST-PILOT   (isTestPilot      — TEST_PILOT / PILOT_LEAD)
//   4º CLIENTES B2B (isAccountMember  — Aislamiento estricto por accountId/tenantId)
//   5º EDU          (isAccountMember  — Sandbox académico sin alta interna no autorizada)
//
// Assumed Data Model (Resumen Estructural):
//   - /user_directory/{run}: { uid, email, run, updatedAt } — Exclusivo Admin/Backend
//   - /users/{userId}: { uid, email, displayName, role (server-only), memberships (server-only), status (server-only), preferences, updatedAt }
//   - /user_auth_credentials/{userId}, /webauthn_challenges/{id}, /dev_challenges/{id}, /system_dev_meta/{id}: Secretos Auth Server-Only
//   - /webauthn_credentials/{credId}: { uid, credentialId, publicKey, counter, transports, createdAt } — Lectura titular/Admin, Escritura Server-Only
//   - /m2m_wallets/{walletId}, /x402_receipts/{receiptId}, /audit_ledger_head/{docId}: Finanzas M2M y cabeza SHA-256 Server-Only (lectura Admin)
//   - /ai_telemetry/{docId}: Telemetría Enjambre Gemini — Lectura Admin/TestPilot, Escritura Server-Only
//   - /accounts/{accountId}: { ownerId, name, contract (server-only), licensing (server-only), status (server-only), branding, operationalSettings }
//   - /accounts/{accountId}/members/{memberId}: { userId, email, role, status, invitedAt } — Bloquea alta si licensing.allowInternalUsers == false
//   - Colecciones Multi-Tenant Operativas (tenant_assets, tenant_catalogs, inspections, fleet_inspections, machinery_fleet,
//     equipment_inspections, stockpiles, financial_events, job_profiles, project_profiles, report_templates, generated_reports):
//     Requieren tenantId/tenant_id/accountId string no vacío con pertenencia verificada e inmutabilidad cross-tenant en update.
//   - Ledgers Inmutables (audit_ledger, event_ledger, financial_ledger): Append-Only (update/delete == false).
//   - Bóvedas Plan Maestro v4.0 (global_asset_catalog, global_equipment_types, global_asset_lineages, master_symbology_vault,
//     media_registry, benchmark_events, benchmark_insights, knowledge_contributions, commons_airlock_queue,
//     global_material_catalog, symbology_review_queue).
//   - /global_equipment_types/{typeId}: { type_key, canonical_type_es, categoria_equipo, type_aliases, search_tokens,
//     embedding_768_raw, spec_schema, schema_version, origin, is_human_locked, usage_count, created_at, updated_at }
//   - /global_asset_lineages/{lineageId}: { lineage_key, schema_version, raw_query_sample, is_generic, total_candidates,
//     candidates, updated_at }
//   - /global_asset_catalog/{assetId}/pillars/{pillarId}, /item_revisions/{revId} (append-only), /derived/{docId}:
//     Particionamiento Anti-1MiB OPERMAQ v3.0 con segregación estricta OEM (1º DEV / 3º TEST-PILOT).
//   - /edu_sandbox_fleet/{unitId}: Flota sandbox aislada multi-tenant para 5º EDU.
//   - /ai_grounded_discovery_cache/{cacheKey}: Caché server-only (southamerica-west1) de descubrimiento IA fundamentado.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. Helpers de Identidad y Jerarquía Soberana (RBAC Estricto)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Compatibilidad controlada con rol persistido por servidor en /users/{uid}.
    // Seguro porque /users/{userId} bloquea al 100% que el cliente cree o modifique `role`.
    function hasServerAssignedRole(allowedRoles) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null &&
        userDoc.data != null &&
        ('role' in userDoc.data) &&
        (userDoc.data.role in allowedRoles);
    }

    // 1º Jerarquía Soberana — DEV_ROOT
    function isDevRoot() {
      return request.auth != null && (
        ('role' in request.auth.token && request.auth.token.role == 'DEV_ROOT') ||
        ('isMasterDev' in request.auth.token && request.auth.token.isMasterDev == true) ||
        request.auth.uid == 'dev-master-root-uid' ||
        ('email' in request.auth.token &&
          request.auth.token.email == 'dev@minreport.com' &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true) ||
        hasServerAssignedRole(['DEV_ROOT'])
      );
    }

    // 2º Jerarquía Soberana — SUPER_ADMIN
    function isSuperAdmin() {
      return request.auth != null && (
        ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        request.auth.uid == 'super-admin-uid' ||
        ('email' in request.auth.token &&
          request.auth.token.email == 'admin@minreport.com' &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true) ||
        hasServerAssignedRole(['SUPER_ADMIN'])
      );
    }

    // 3º Jerarquía Soberana — TEST-PILOT / PILOT_LEAD
    function isTestPilot() {
      return request.auth != null && (
        ('role' in request.auth.token &&
          (request.auth.token.role == 'TEST_PILOT' || request.auth.token.role == 'PILOT_LEAD')) ||
        hasServerAssignedRole(['TEST_PILOT', 'PILOT_LEAD'])
      );
    }

    // Gobierno Administrativo Superior (1º DEV + 2º ADMIN)
    function isAdmin() {
      return isDevRoot() || isSuperAdmin();
    }

    // Privilegio Transversal de Sistema (1º DEV + 2º ADMIN + 3º TEST-PILOT)
    function isSystemPrivileged() {
      return isDevRoot() || isSuperAdmin() || isTestPilot();
    }

    // Curación Técnica de Ingeniería OPERMAQ (1º DEV + 3º TEST-PILOT; excluye mutación directa de 2º ADMIN)
    function canCurateOpermaq() {
      return isDevRoot() || isTestPilot();
    }

    // 4º y 5º Jerarquía Soberana — Pertenencia estricta a cuenta B2B / EDU (Aislamiento Multi-Tenant puro)
    function isAccountMember(accountId) {
      return request.auth != null &&
        accountId is string &&
        accountId.size() > 0 &&
        accountId.size() <= 128 &&
        (
          isSystemPrivileged() ||
          ('activeAccountId' in request.auth.token && request.auth.token.activeAccountId == accountId) ||
          ('tenantId' in request.auth.token && request.auth.token.tenantId == accountId) ||
          exists(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)) ||
          (
            exists(/databases/$(database)/documents/accounts/$(accountId)) &&
            'ownerId' in get(/databases/$(database)/documents/accounts/$(accountId)).data &&
            get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid
          )
        );
    }

    // Administración Interna de Cuenta Titular (Owner o Member con rol OWNER/ADMIN)
    function isAccountAdmin(accountId) {
      return request.auth != null &&
        accountId is string &&
        accountId.size() > 0 &&
        accountId.size() <= 128 &&
        (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/accounts/$(accountId)) &&
            'ownerId' in get(/databases/$(database)/documents/accounts/$(accountId)).data &&
            get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid
          ) ||
          (
            exists(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)) &&
            'role' in get(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)).data.role in ['OWNER', 'ADMIN']
          ) ||
          (
            (
              ('activeAccountId' in request.auth.token && request.auth.token.activeAccountId == accountId) ||
              ('tenantId' in request.auth.token && request.auth.token.tenantId == accountId)
            ) &&
            'role' in request.auth.token &&
            request.auth.token.role in ['OWNER', 'ADMIN']
          )
        );
    }

    // Verifica que la licencia de la cuenta permita usuarios internos (Cierra bypass EDU)
    function accountAllowsInternalUsers(accountId) {
      return exists(/databases/$(database)/documents/accounts/$(accountId)) &&
        (
          !('licensing' in get(/databases/$(database)/documents/accounts/$(accountId)).data) ||
          get(/databases/$(database)/documents/accounts/$(accountId)).data.licensing == null ||
          !('allowInternalUsers' in get(/databases/$(database)/documents/accounts/$(accountId)).data.licensing) ||
          get(/databases/$(database)/documents/accounts/$(accountId)).data.licensing.allowInternalUsers != false
        );
    }

    // ===============================================================
    // 2. Helpers Multi-Tenant y Validadores de Dominio (Anti-DoS)
    // ===============================================================

    // Extrae identificador multi-tenant soportando tenantId, tenant_id y accountId
    function docTenantId(data) {
      return ('tenantId' in data && data.tenantId is string && data.tenantId.size() > 0)
        ? data.tenantId
        : (
          ('tenant_id' in data && data.tenant_id is string && data.tenant_id.size() > 0)
            ? data.tenant_id
            : (
              ('accountId' in data && data.accountId is string && data.accountId.size() > 0)
                ? data.accountId
                : null
            )
        );
    }

    // Impide ataques de confusión entre llaves multi-tenant en un mismo documento
    function isConsistentTenantFields(data) {
      let tid = ('tenantId' in data && data.tenantId != null) ? data.tenantId : null;
      let tidSnake = ('tenant_id' in data && data.tenant_id != null) ? data.tenant_id : null;
      let aid = ('accountId' in data && data.accountId != null) ? data.accountId : null;
      return (tid == null || (tid is string && tid.size() > 0 && tid.size() <= 128)) &&
        (tidSnake == null || (tidSnake is string && tidSnake.size() > 0 && tidSnake.size() <= 128)) &&
        (aid == null || (aid is string && aid.size() > 0 && aid.size() <= 128)) &&
        (tid == null || tidSnake == null || tid == tidSnake) &&
        (tid == null || aid == null || tid == aid) &&
        (tidSnake == null || aid == null || tidSnake == aid);
    }

    // Evalúa lectura multi-tenant alineada con el planificador estático de queries de Firestore
    function canReadTenantDoc(data) {
      return (docTenantId(data) is string && isAccountMember(docTenantId(data))) ||
        ('tenantId' in data && data.tenantId is string && isAccountMember(data.tenantId)) ||
        ('tenant_id' in data && data.tenant_id is string && isAccountMember(data.tenant_id)) ||
        ('accountId' in data && data.accountId is string && isAccountMember(data.accountId));
    }

    // Validador general de cotas anti-DoS para colecciones operativas multi-tenant (Create & Update)
    function isBoundedPayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 200 &&
        isConsistentTenantFields(data) &&
        (!('observations' in data) || data.observations == null || (data.observations is string && data.observations.size() <= 20000)) &&
        (!('notas' in data) || data.notas == null || (data.notas is string && data.notas.size() <= 20000));
    }

    // Validador de dominio para perfiles en /users/{userId} (Create & Update)
    function isValidUserProfilePayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 60 &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 200)) &&
        (!('firstName' in data) || data.firstName == null || (data.firstName is string && data.firstName.size() <= 120)) &&
        (!('lastName' in data) || data.lastName == null || (data.lastName is string && data.lastName.size() <= 120)) &&
        (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 200)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
        (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 2048)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('preferredLanguage' in data) || data.preferredLanguage == null || (data.preferredLanguage is string && data.preferredLanguage.size() <= 16)) &&
        (!('language' in data) || data.language == null || (data.language is string && data.language.size() <= 16)) &&
        (!('theme' in data) || data.theme == null || (data.theme is string && data.theme.size() <= 32)) &&
        (!('preferences' in data) || data.preferences == null || (data.preferences is map && data.preferences.keys().size() <= 50));
    }

    // Validador de dominio para actualización de perfil comercial en /accounts/{accountId}
    function isValidAccountPayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 80 &&
        (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 250)) &&
        (!('fantasyName' in data) || data.fantasyName == null || (data.fantasyName is string && data.fantasyName.size() <= 250)) &&
        (!('nombreFantasia' in data) || data.nombreFantasia == null || (data.nombreFantasia is string && data.nombreFantasia.size() <= 250)) &&
        (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 300)) &&
        (!('direccionComercial' in data) || data.direccionComercial == null || (data.direccionComercial is string && data.direccionComercial.size() <= 300)) &&
        (!('direccionSucursal' in data) || data.direccionSucursal == null || (data.direccionSucursal is string && data.direccionSucursal.size() <= 300)) &&
        (!('commune' in data) || data.commune == null || (data.commune is string && data.commune.size() <= 120)) &&
        (!('region' in data) || data.region == null || (data.region is string && data.region.size() <= 120)) &&
        (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 120)) &&
        (!('country' in data) || data.country == null || (data.country is string && data.country.size() <= 120)) &&
        (!('postal_code' in data) || data.postal_code == null || (data.postal_code is string && data.postal_code.size() <= 32)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
        (!('telefonoPrincipal' in data) || data.telefonoPrincipal == null || (data.telefonoPrincipal is string && data.telefonoPrincipal.size() <= 50)) &&
        (!('telefonoSecundario' in data) || data.telefonoSecundario == null || (data.telefonoSecundario is string && data.telefonoSecundario.size() <= 50)) &&
        (!('contactEmail' in data) || data.contactEmail == null || (data.contactEmail is string && data.contactEmail.size() <= 254)) &&
        (!('emailComercial' in data) || data.emailComercial == null || (data.emailComercial is string && data.emailComercial.size() <= 254)) &&
        (!('emailTributario' in data) || data.emailTributario == null || (data.emailTributario is string && data.emailTributario.size() <= 254)) &&
        (!('email_domain' in data) || data.email_domain == null || (data.email_domain is string && data.email_domain.size() <= 120)) &&
        (!('giro' in data) || data.giro == null || (data.giro is string && data.giro.size() <= 300)) &&
        (!('activity' in data) || data.activity == null || (data.activity is string && data.activity.size() <= 300));
    }

    // Validador estructural y prevención de DoS para colecciones técnicas OPERMAQ / Plan Maestro v4.0
    function isValidOpermaqPayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 120 &&
        isConsistentTenantFields(data) &&
        (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 500)) &&
        (!('content' in data) || data.content == null || (data.content is string && data.content.size() <= 900000)) &&
        (!('notas' in data) || data.notas == null || (data.notas is string && data.notas.size() <= 10000)) &&
        (!('observations' in data) || data.observations == null || (data.observations is string && data.observations.size() <= 10000)) &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 10000)) &&
        (!('messages' in data) || data.messages == null || (data.messages is list && data.messages.size() <= 500));
    }

    // ===============================================================
    // 3. Identidad, PII, Passkeys WebAuthn, M2M x402 y Secretos
    // ===============================================================

    // Directorio de identificación RUT (Cero exposición PII a clientes comunes; resolución vía Admin SDK)
    match /user_directory/{run} {
      allow read, write: if isAdmin();
    }

    // Perfiles de usuario (Cero enumeración y bloqueo total de auto-escalamiento de rol/memberships)
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isOwner(userId) ||
        (userId == 'dev-master-root-uid' ? isDevRoot() : isAdmin())
      );
      allow list: if isAdmin();

      allow create: if isValidUserProfilePayload(request.resource.data) && (
        (userId == 'dev-master-root-uid' ? isDevRoot() : isAdmin()) ||
        (
          isOwner(userId) &&
          userId != 'dev-master-root-uid' &&
          userId != 'super-admin-uid' &&
          (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
          !('isMasterDev' in request.resource.data) &&
          !('admin' in request.resource.data) &&
          !('passwordHash' in request.resource.data) &&
          !('entitlements' in request.resource.data) &&
          !('status' in request.resource.data) &&
          !('accountTier' in request.resource.data) &&
          !('classification' in request.resource.data) &&
          (!('role' in request.resource.data) || request.resource.data.role in ['OPERATOR', 'VIEWER', 'STUDENT']) &&
          (!('memberships' in request.resource.data) ||
            (request.resource.data.memberships is list && request.resource.data.memberships.size() == 0))
        )
      );

      allow update: if isValidUserProfilePayload(request.resource.data) && (
        (userId == 'dev-master-root-uid' ? isDevRoot() : isAdmin()) ||
        (
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'firstName',
            'lastName',
            'name',
            'phone',
            'avatar',
            'photoURL',
            'preferences',
            'preferredLanguage',
            'language',
            'theme',
            'updatedAt',
            'lastLoginAt'
          ])
        )
      );

      // Prohibición de purga para cuentas raíz soberanas
      allow delete: if isAdmin() && userId != 'dev-master-root-uid' && userId != 'super-admin-uid';

      // Mensajería y Notificaciones internas del usuario
      match /inbox/{messageId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create, update: if (isAdmin() || isOwner(userId)) && isBoundedPayload(request.resource.data);
        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    // Credenciales y secretos internos de autenticación (Exclusivo Admin SDK)
    match /user_auth_credentials/{userId} {
      allow read, write: if false;
    }

    // Llaves públicas Passkeys / WebAuthn FIDO2
    match /webauthn_credentials/{credId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && 'uid' in resource.data && resource.data.uid == request.auth.uid)
      );
      allow write: if false;
    }

    // Challenges efímeros WebAuthn FIDO2 (Exclusivo Admin SDK)
    match /webauthn_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Challenges y metadatos criptográficos de gateway DEV_ROOT (Exclusivo Admin SDK)
    match /dev_challenges/{challengeId} {
      allow read, write: if false;
    }

    match /system_dev_meta/{docId} {
      allow read, write: if false;
    }

    match /system_emails/{emailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Monetización M2M y Protocolo x402 (Escritura exclusiva Admin SDK)
    match /m2m_wallets/{walletId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /x402_receipts/{receiptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cabeza de cadena hash SHA-256 del Audit Ledger (Escritura exclusiva Admin SDK)
    match /audit_ledger_head/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Telemetría operativa del Enjambre Gemini IA
    match /ai_telemetry/{docId} {
      allow read: if isAdmin() || isTestPilot();
      allow write: if false;
    }

    // Logs administrativos internos del panel Super Admin (Append-Only)
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isBoundedPayload(request.resource.data);
      allow update, delete: if false;
    }

    // ===============================================================
    // 4. Cuentas Soberanas B2B / EDU, Miembros y Configuración Global
    // ===============================================================

    match /accounts/{accountId} {
      allow read: if isAuthenticated() && (
        isAccountMember(accountId) ||
        isAdmin() ||
        isSystemPrivileged() ||
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (
          resource != null &&
          'primaryOperator' in resource.data &&
          resource.data.primaryOperator is map &&
          'email' in resource.data.primaryOperator &&
          'email' in request.auth.token &&
          resource.data.primaryOperator.email == request.auth.token.email
        )
      );

      // Alta exclusiva por servidor (/api/auth/register Admin SDK) o Super Admin / DevRoot
      allow create: if isAdmin() && isValidAccountPayload(request.resource.data);

      // Bloquea alteración cliente de contract, licensing, status, enabledPlugins y ownerId
      allow update: if isValidAccountPayload(request.resource.data) && (
        isAdmin() ||
        (
          (
            ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
            isAccountAdmin(accountId)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'fantasyName',
            'nombreFantasia',
            'address',
            'direccionComercial',
            'direccionSucursal',
            'commune',
            'region',
            'city',
            'country',
            'postal_code',
            'phone',
            'telefonoPrincipal',
            'telefonoSecundario',
            'contactEmail',
            'emailComercial',
            'emailTributario',
            'email_domain',
            'giro',
            'activity',
            'branding',
            'operationalSettings',
            'updatedAt'
          ])
        ) ||
        (
          resource != null &&
          'primaryOperator' in resource.data &&
          resource.data.primaryOperator is map &&
          resource.data.primaryOperator.status == 'PENDING' &&
          'email' in request.auth.token &&
          resource.data.primaryOperator.email == request.auth.token.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primaryOperator']) &&
          'primaryOperator' in request.resource.data &&
          request.resource.data.primaryOperator is map &&
          request.resource.data.primaryOperator.uid == request.auth.uid &&
          request.resource.data.primaryOperator.status == 'ACTIVE'
        )
      );

      allow delete: if isAdmin() && accountId != 'dev-master-sandbox';

      // Subcolección: Perfiles de Cargo por Cuenta
      match /job_profiles/{profileId} {
        allow read: if isAccountMember(accountId);
        allow create, update: if isAccountMember(accountId) && isBoundedPayload(request.resource.data);
        allow delete: if isAccountAdmin(accountId) || isAccountMember(accountId);
      }

      // Subcolección: Miembros Internos (Cierra bypass EDU validando licensing.allowInternalUsers)
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == memberId ||
          isAccountMember(accountId) ||
          isAdmin()
        );
        allow create, update: if isBoundedPayload(request.resource.data) && (
          isAdmin() ||
          (
            isAccountAdmin(accountId) &&
            accountAllowsInternalUsers(accountId) &&
            (!('role' in request.resource.data) ||
              !(request.resource.data.role in ['DEV_ROOT', 'SUPER_ADMIN', 'TEST_PILOT', 'PILOT_LEAD']))
          )
        );
