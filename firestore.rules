          isSystemPrivileged() ||
          (
            isTenantMatchCreate(request.resource.data) &&
            request.resource.data.get('actorUid', null) in [null, request.auth.uid] &&
            request.resource.data.get('userId', null) in [null, request.auth.uid]
          )
        );
      allow update: if false;
      allow delete: if isAuthenticated() && isAdmin();
