    // Registro global del motor on-demand de compatibilidad móvil (Lectura autenticada; escritura exclusiva Cloud Run Admin SDK)
    match /device_compatibility_registry/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if false;
