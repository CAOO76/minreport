rules_version = '2';

// ===============================================================
// MINREPORT Web 3.0 — Seguridad Bancaria Multi-Tenant (ISO 27001)
// Jerarquía Soberana de 5 Tipos de Cuenta:
//   1º DEV          (isDevRoot        — DEV_ROOT / dev@minreport.com verificado)
//   2º ADMIN        (isSuperAdmin     — SUPER_ADMIN / admin@minreport.com verificado)
//   3º TEST-PILOT   (isTestPilot      — TEST_PILOT hermético: caducidad token + /users/{uid} + /test_pilots/{pilotAccountId}|{uid} ACTIVE, confinado a su propio sandbox pilot-*)
//   4º CLIENTES B2B (isAccountMember  — Aislamiento estricto por accountId/tenantId con membresía ACTIVA)
//   5º EDU          (isAccountMember  — Sandbox académico con membresía ACTIVA sin alta interna no autorizada)
//
// Assumed Data Model (Resumen Estructural):
//   - /user_directory/{run}: { uid, email, run, updatedAt } — Exclusivo Admin/Backend
//   - /users/{userId}: { uid, email, displayName, role (server-only), memberships (server-only), status (server-only), preferences, lastActiveAccountId, updatedAt }
//   - /user_auth_credentials/{userId}, /webauthn_challenges/{id}, /dev_challenges/{id}, /auth_otp_challenges/{id}, /setup_tokens/{id}, /system_dev_meta/{id}: Secretos Auth Server-Only
//   - /webauthn_credentials/{credId}: { uid, credentialId, publicKey, counter, transports, createdAt } — Lectura titular/Admin, Escritura Server-Only
//   - /m2m_wallets/{walletId}, /x402_receipts/{receiptId}, /audit_ledger_head/{docId}: Finanzas M2M y cabeza SHA-256 Server-Only (lectura Admin)
//   - /ai_telemetry/{docId}: Telemetría Enjambre Gemini — Lectura Admin/TestPilot, Escritura Server-Only
//   - /ai_inference_cache/{cacheKey}: Caché inferencia/embeddings IA — Lectura exclusiva Admin, Escritura Server-Only
//   - /accounts/{accountId}: { ownerId, name, contract (server-only), licensing (server-only), status (server-only), branding, operationalSettings }
//   - /accounts/{accountId}/members/{memberId}: { userId, email, role, status, invitedAt } — Bloquea alta si licensing.allowInternalUsers == false
//   - /accounts/{accountId}/metrics/{periodId}: Telemetría atómica por cuenta/periodo — Lectura miembros de cuenta/Admin, Escritura Server-Only
//   - /accounts/{accountId}/manufacturer_contacts/{contactId}: { contactId (== docId, immutable en update), tenantId (== accountId, immutable), supplierKey, manufacturerKey, distributorName, areaName, areaKey, contactLabel, channelType ('NEW'|'USED'|'RENTAL'|'PARTS'|'SERVICE', opcional/nullable), cityRegion, phone, emailOrWeb, notes, createdByUid (== auth.uid en create, immutable en update), createdAt, updatedAt } — Anillo A Agenda Privada Multi-Tenant Offline-First; lectura isAccountMember, escritura bloqueada para 5º EDU
//   - /accounts/{accountId}/supplier_billing_rules/{supplierKey}: { tenantId (== accountId), supplierKey (== docId), requiresPurchaseOrder801, requiresContract803, requiresDispatchGuide52, requiresReceptionTokenType ('NONE'|'HES'|'HEM'|'HAS'), defaultFormaPagoDte (1|2|3), paymentTermDays (0..365, Ley 21.131: <=30 o hasExceptionalPaymentAgreement), hasExceptionalPaymentAgreement, exceptionalAgreementNote, dteClaimWindowDays (1..8), rcvClaimAlertEmail, allowFactoringCesion, billingPortalUrl, remittanceEmail, defaultCentroCosto, notes, updatedByUid, updatedAt } — Reglas DTE/Pago privadas por tenant; lectura isAccountMember, escritura/borrado bloqueado para 5º EDU
//   - /edu_metrics/{metricId}: Telemetría separada cuentas académicas EDU — Lectura exclusiva Admin (DEV_ROOT/SUPER_ADMIN), Escritura Server-Only
//   - /edu_institutions/{institutionId}: Padrón de Instituciones Académicas Acreditadas — Lectura autenticada, Escritura Server-Only ("ACTUALIZAR" + AuditLedger)
//   - /pilot_feedback/{feedbackId}: Observaciones TEST-PILOT — Lectura DEV_ROOT o autorUid, Create status=='OPEN' con authorUid propio, Update/Delete exclusivo DEV_ROOT
//   - /hitl_candidates/{candidateId}: Candidatos HITL — Update/Delete exclusivo DEV_ROOT (Mitigación F1)
//   - Colecciones Multi-Tenant Operativas (tenant_assets, tenant_catalogs, inspections, fleet_inspections, machinery_fleet,
//     equipment_inspections, stockpiles, job_profiles, project_profiles, report_templates, generated_reports,
//     edu_sandbox_fleet):
//     Requieren tenantId/tenant_id/accountId string no vacío con pertenencia verificada, inmutabilidad cross-tenant en update y delete exclusivo isTenantAdminOrOwner.
//   - /stockpiles/{stkId}: Acopios STOCKPILE CONTROL Next-Gen — Aislamiento multi-tenant estricto + descripción, mapa estático CAS (static_map_url/sha256/bytes), deltas de volumen, proyecto (project_id/project_name), cierre de ciclo exclusivo móvil (closed_at/by, closure_reason ['SHIPPED'|'FIELD_REMOVED'|'ZERO_VOLUME'|'MANUAL_CLOSE'], closure_cause <= 300, closure_origin ['MOBILE_FIELD'], dispatch_reference, dispatch_transport <= 200, dispatch_destination <= 200, dispatch_timestamp >= 0, shipped_weight_t, pre_closure_volume_m3) y bloqueo data: Base64 en URLs.
//   - /stockpiles/{stkId}/measurements/{measId}: Mediciones STOCKPILE CONTROL Next-Gen — volumen_m3 >= 0, peso_t >= 0, cadena previa (previous_measurement_id/photo_url), deltas, metadatos de cierre y despacho (closure_reason ['SHIPPED'|'FIELD_REMOVED'|'ZERO_VOLUME'|'MANUAL_CLOSE'], closure_cause <= 300, closure_origin ['MOBILE_FIELD'], dispatch_transport <= 200, dispatch_destination <= 200, dispatch_timestamp >= 0) y bloqueo data: Base64 en photo_url/previous_photo_url/mesh_url.
//   - /device_calibrations/{calId}: Calibración geométrica on-demand por dispositivo (R5) — Aislamiento multi-tenant estricto, rango scaleFactor [0.85..1.15], distancias y calibratedAt > 0, campos opcionales (id, calibrationId, deviceId, deviceModel, platform <= 32, calibratedBy, userId, actorUid, tenantId, region, planeNoiseRmsM, imuPitchOffsetDeg, imuRollOffsetDeg, createdAt), sin PII (actorEmail/email/ipAddress prohibidos), append-only en cliente (update == false, delete exclusivo isAdmin).
//   - /device_compatibility_registry/{deviceId}: Registro global del motor on-demand de compatibilidad móvil — Lectura autenticada (isAuthenticated), escritura bloqueada en cliente (exclusivo Cloud Run Admin SDK).
//   - /financial_events/{eventId}: Append-Only estricto (create exclusivo Admin/Owner de cuenta, update/delete == false).
//   - /audit_ledger/{logId}: Cadena SHA-256 Server-Only (create/update/delete == false; lectura Admin o auditor titular sin cruce multi-tenant).
//   - Ledgers Operativos Inmutables (event_ledger, financial_ledger): Append-Only (update/delete == false).
//   - Bóvedas Plan Maestro v4.0 (global_asset_catalog, global_equipment_types, global_asset_lineages, master_symbology_vault,
//     media_registry, benchmark_events, benchmark_insights, knowledge_contributions, commons_airlock_queue,
//     global_material_catalog, symbology_review_queue).
//   - /global_equipment_types/{typeId}: { type_key, canonical_type_es, categoria_equipo, type_aliases, search_tokens,
//     embedding_768_raw, spec_schema, schema_version, origin, is_human_locked, usage_count, created_at, updated_at }
//   - /global_asset_lineages/{lineageId}: { lineage_key, schema_version, raw_query_sample, is_generic, total_candidates,
//     candidates, updated_at }
//   - /global_asset_catalog/{assetId}/pillars/{pillarId}, /item_revisions/{revId} (append-only), /derived/{docId}:
//     Particionamiento Anti-1MiB OPERMAQ v3.0 con segregación estricta OEM (1º DEV / 3º TEST-PILOT).
//   - /edu_sandbox_fleet/{unitId}: Flota sandbox aislada multi-tenant para 5º EDU.
//   - /ai_grounded_discovery_cache/{cacheKey}: Caché server-only (southamerica-west1) de descubrimiento IA fundamentado.
//   - /global_manufacturers/{manufacturerId}: { manufacturerKey, officialName, aliases, hqCountryIso2, officialWebsiteUrl, observedArchetypeIds, logoSvg, logoCandidates, curationStatus, hasPublicWebFootprint, equipmentCount, aiSuggestedDistributors, createdAt, updatedAt, verifiedByUid } — Maestra global de fabricantes Zero-Preset (OPERMAQ · FABRICANTES); lectura autenticada, escritura exclusiva Admin SDK (HITL "ACTUALIZAR" + AuditLedger).
//   - /global_suppliers/{supplierId}: { supplierKey, tradeName, legalName, countryIso2, supplierTaxId, officialWebsiteUrl, x402SellerWalletId, manufacturerKeys, representations, createdAt, updatedAt } — Entidad comercial única multimarca unificada (distribuidores, arriendo, Reman, especialistas y semilla KYB/x402 Marketplace); lectura autenticada, escritura exclusiva Admin SDK (HITL "ACTUALIZAR").
//   - /supplier_channel_rules/{ruleId}: Legado sellado tras unificación en /global_suppliers.representations[] (read/write == false).
//   - /supplier_contact_contributions/{contributionId}: { contributionId, manufacturerKey, distributorName, channelType, countryIso2, cityRegion, roleEmail, phone, portalUrl, sanitizedNotes, piiPurgedTypes, piiPurgedCount, status, submittedByTenantHash, createdAt, reviewedAt, reviewedByUid, ttlExpiresAt } — Cola de aportes comunitarios moderados Ley N° 19.628 / N° 21.719; lectura exclusiva 1º DEV / 2º ADMIN (isAdmin), escritura exclusiva Admin SDK (ConfidentialityAirlockService + bloqueo 5º EDU).
//   - MINREPORT · ABASTECIMIENTO (`moduleId: 'supply'` — Base Única `southamerica-west1`, mutaciones server-authoritative vía `/api/supply/*` Admin SDK + Zod + CAS + SII + HITL "ACTUALIZAR" + AuditLedger):
//     * /global_supply_catalog/{skuId}: Catálogo maestro común sin tenantId ni PII — Docs globales públicos legibles por usuarios activos no suspendidos/revocados; docs con tenantId no vacío o scope=='TENANT_PRIVATE' legibles únicamente por 1º DEV / 2º ADMIN o miembros activos del mismo tenantId; escritura/borrado exclusivo 1º DEV / 2º ADMIN con validador anti-PII y sin tenantId no controlado.
//     * /global_supply_policy_presets/{roleId}: Presets globales de políticas y topes de aprobación por rol — Lectura autenticada activa (excluyendo suspendidos/revocados/pilotos expirados), escritura/borrado exclusivo 1º DEV / 2º ADMIN con validador de dominio y campos inmutables.
//     * /global_suppliers/{supplierId}: Ya gobernado en §8.1 (`allow read: if isAuthenticated(); allow write: if false;`).
//     * /supply_whatsapp_sessions/{sessionId}, /supply_whatsapp_wamids/{wamid}: Secretos/estado conversacional efímero WhatsApp y guardia atómica de idempotencia (Ley N° 21.719) — Bloqueo total cliente (`read/write == false`).
//     * /supply_policy_audit/{eventId}: Auditoría de políticas de abastecimiento — Lectura tenant-scoped exclusiva OWNER/ADMIN ACTIVO del tenant auditable o 1º DEV / 2º ADMIN (sin bypass por claim obsoleto ni TEST_PILOT); escritura cliente denegada (`write == false`).
//     * /market_demand_signals/{signalId}: Señales anónimas de demanda agregadas k>=3 (Ley N° 21.719, sin tenantId ni GPS) — Lectura autenticada activa, escritura exclusiva Admin SDK (`write == false`).
//     * Colecciones operativas y ledgers multi-tenant (`tenant_suppliers`, `supply_sites`, `supply_warehouses`, `supply_inventory_items`, `supply_requisitions` + subcolección `lines`, `supply_requisition_lines`, `supply_purchases` + subcolección `lines`, `supply_purchase_lines`, `supply_fulfillment_allocations`, `supply_assets`, `supply_stock_ledger`, `supply_cash_ledger`, `supply_sii_documents`, `supply_expense_reports`, `supply_demand_forecasts`): Todas portan `tenantId`; lectura estrictamente aislada por `tenantId` (miembro directo ACTIVO B2B/EDU, 1º DEV / 2º ADMIN, o 3º TEST-PILOT hermético verificado en `/test_pilots/{uid}` confinado estrictamente a `pilot-{uid}` o `pilotAccountId`); toda escritura cliente denegada (`create, update, delete == false`).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. Helpers de Identidad y Jerarquía Soberana (RBAC Estricto)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Compatibilidad controlada con rol persistido por servidor en /users/{uid}.
    // Seguro porque /users/{userId} bloquea al 100% que el cliente cree o modifique `role`.
    function hasServerAssignedRole(allowedRoles) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null &&
        userDoc.data != null &&
        userDoc.data.get('role', null) in allowedRoles &&
        !(userDoc.data.get('status', '') in ['REVOKED', 'SUSPENDED']);
    }

    function isDevRootTokenClaim() {
      return request.auth.uid == 'dev-master-root-uid' ||
        request.auth.token.get('role', '') == 'DEV_ROOT' ||
        request.auth.token.get('isMasterDev', false) == true ||
        (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') == 'dev@minreport.com'
        );
    }

    function isSuperAdminTokenClaim() {
      return request.auth.uid == 'super-admin-uid' ||
        request.auth.token.get('role', '') == 'SUPER_ADMIN' ||
        request.auth.token.get('admin', false) == true ||
        (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') == 'admin@minreport.com'
        );
    }

    // 1º Jerarquía Soberana — DEV_ROOT
    function isDevRoot() {
      return request.auth != null && (
        isDevRootTokenClaim() ||
        hasServerAssignedRole(['DEV_ROOT'])
      );
    }

    // 2º Jerarquía Soberana — SUPER_ADMIN
    function isSuperAdmin() {
      return request.auth != null && (
        isSuperAdminTokenClaim() ||
        hasServerAssignedRole(['SUPER_ADMIN'])
      );
    }

    // Verifica que el perfil /users/{uid} (si existe) no esté revocado, suspendido ni deshabilitado
    function isNotRevokedUser() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'ACTIVE') in ['REVOKED', 'SUSPENDED', 'INACTIVE', 'REMOVED', 'DISABLED']);
    }

    // Identifica si el solicitante porta identidad o perfil de 3º TEST-PILOT (aunque esté expirado o revocado)
    function isPilotIdentity() {
      return request.auth != null && (
        'pilotExpiresAt' in request.auth.token ||
        request.auth.token.get('role', '') == 'TEST_PILOT' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'TEST_PILOT'
        )
      );
    }

    // Valida formato estricto de sandbox 3º TEST-PILOT (`pilot-*`, sin saltos de segmento)
    function isPilotAccountIdFormat(accountId) {
      return accountId is string &&
        accountId.size() > 6 &&
        accountId.size() <= 128 &&
        accountId.matches('^pilot-.*') &&
        !accountId.matches('.*/.*');
    }

    // Valida expiración de 3º TEST-PILOT soportando Firestore Timestamp y epoch ms numérico (int/float), fail-closed
    function isValidPilotExpiresAt(expiresAt) {
      return expiresAt == null ||
        (expiresAt is timestamp && request.time < expiresAt) ||
        ((expiresAt is int || expiresAt is float) && request.time.toMillis() < expiresAt);
    }

    // Valida datos de registro vivo en /test_pilots/{docId}: lista blanca estricta status == 'ACTIVE' y expiración vigente
    function isActiveTestPilotDocData(pilotData) {
      return pilotData is map &&
        pilotData.get('status', 'ACTIVE') == 'ACTIVE' &&
        (!('expiresAt' in pilotData) || isValidPilotExpiresAt(pilotData.expiresAt));
    }

    // Layout A (real dev.controller.ts): /test_pilots/{pilotAccountId} con prefijo pilot-, userId == uid y status == 'ACTIVE'
    function isValidAccountKeyedTestPilotDoc(pilotAccountId) {
      return isPilotAccountIdFormat(pilotAccountId) &&
        exists(/databases/$(database)/documents/test_pilots/$(pilotAccountId)) &&
        get(/databases/$(database)/documents/test_pilots/$(pilotAccountId)).data is map &&
        get(/databases/$(database)/documents/test_pilots/$(pilotAccountId)).data.get('userId', '') == request.auth.uid &&
        isActiveTestPilotDocData(get(/databases/$(database)/documents/test_pilots/$(pilotAccountId)).data);
    }

    // Layout B (fallback legacy / tests): /test_pilots/{uid} con status == 'ACTIVE' y expiración vigente
    function isValidUidKeyedTestPilotDoc() {
      return exists(/databases/$(database)/documents/test_pilots/$(request.auth.uid)) &&
        isActiveTestPilotDocData(get(/databases/$(database)/documents/test_pilots/$(request.auth.uid)).data) &&
        (
          !('userId' in get(/databases/$(database)/documents/test_pilots/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/test_pilots/$(request.auth.uid)).data.userId == request.auth.uid
        );
    }

    // Resuelve candidato pilotAccountId desde token (`activeAccountId`/`tenantId`) o `/users/{uid}.primaryAccountId`
    function hasValidTokenOrProfilePilotAccountDoc() {
      let tokenActiveAcc = request.auth.token.get('activeAccountId', '');
      let tokenTenantId = request.auth.token.get('tenantId', '');
      return isValidAccountKeyedTestPilotDoc(tokenActiveAcc) ||
        isValidAccountKeyedTestPilotDoc(tokenTenantId) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          isValidAccountKeyedTestPilotDoc(
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('primaryAccountId', '')
          )
        );
    }

    // Exige verificación real y vigente en /test_pilots/ soportando Layout A (/test_pilots/{pilotAccountId}) y Layout B (/test_pilots/{uid})
    function hasValidTestPilotDoc() {
      return hasValidTokenOrProfilePilotAccountDoc() || isValidUidKeyedTestPilotDoc();
    }

    function isNotRevokedPilotUserData(uData) {
      return uData is map &&
        uData.get('role', '') == 'TEST_PILOT' &&
        !(uData.get('status', 'ACTIVE') in ['REVOKED', 'SUSPENDED', 'INACTIVE', 'REMOVED', 'DISABLED']);
    }

    // Verifica estado vivo en servidor (/users/{uid}) para revocación inmediata de 3º TEST-PILOT
    function isNotRevokedPilotUser() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isNotRevokedPilotUserData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // 3º Jerarquía Soberana — TEST-PILOT hermético: validación token + /users/{uid} vivo + registro /test_pilots/{uid} vigente
    function isTestPilot() {
      return request.auth != null &&
        (!('role' in request.auth.token) || request.auth.token.role == 'TEST_PILOT') &&
        'pilotExpiresAt' in request.auth.token &&
        request.auth.token.pilotExpiresAt is number &&
        request.time.toMillis() < request.auth.token.pilotExpiresAt &&
        isNotRevokedPilotUser() &&
        hasValidTestPilotDoc();
    }

    // Usuario autenticado vigente (excluye cuentas suspendidas/revocadas y pilotos expirados/revocados)
    function isActiveAuthenticatedUser() {
      return isAuthenticated() &&
        isNotRevokedUser() &&
        (!isPilotIdentity() || isTestPilot());
    }

    // Gobierno Administrativo Superior (1º DEV + 2º ADMIN)
    function isAdmin() {
      return isDevRoot() || isSuperAdmin();
    }

    // Privilegio Transversal de Sistema (EXCLUSIVO 1º DEV + 2º ADMIN; 3º TEST-PILOT hermético a su propio sandbox pilot-*)
    function isSystemPrivileged() {
      return request.auth != null && (
        request.auth.uid in ['dev-master-root-uid', 'super-admin-uid'] ||
        request.auth.token.get('role', '') in ['DEV_ROOT', 'SUPER_ADMIN'] ||
        request.auth.token.get('isMasterDev', false) == true ||
        request.auth.token.get('admin', false) == true ||
        (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') in ['dev@minreport.com', 'admin@minreport.com']
        ) ||
        hasServerAssignedRole(['DEV_ROOT', 'SUPER_ADMIN'])
      );
    }

    // Curación Técnica de Ingeniería OPERMAQ (exclusiva 1º DEV; 2º ADMIN solo lectura comercial, 3º TEST-PILOT sin curación de catálogo maestro)
    function canCurateOpermaq() {
      return isDevRoot();
    }

    // Valida que la membresía en /accounts/{accountId}/members/{uid} esté ACTIVA
    // (compatibilidad retroactiva: documentos legacy sin campo `status` se tratan como ACTIVE;
    // cualquier status distinto de 'ACTIVE' —ej. 'SUSPENDED', 'REVOKED', 'INACTIVE', 'REMOVED', 'PENDING_APPROVAL'— es RECHAZADO)
    function isActiveMemberData(memberData) {
      return memberData is map &&
        (!('status' in memberData) || memberData.status == 'ACTIVE');
    }

    // Bloquea bypass por claims obsoletos (`activeAccountId`/`tenantId`) cuando el documento de membresía existe y NO está ACTIVE
    function isNotSuspendedOrRevokedMember(accountId) {
      return !exists(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)) ||
        isActiveMemberData(get(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)).data);
    }

    // Verifica existencia de documento de membresía ACTIVA en /accounts/{accountId}/members/{uid}
    function hasActiveAccountMemberDoc(accountId) {
      return exists(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)) &&
        isActiveMemberData(get(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid)).data);
    }

    // Pertenencia directa B2B / EDU con verificación de membresía ACTIVA (bloquea suspendidos/revocados, claims obsoletos y TEST_PILOT)
    function isDirectAccountMember(accountId) {
      return request.auth != null &&
        accountId is string &&
        accountId.size() > 0 &&
        accountId.size() <= 128 &&
        !isPilotIdentity() &&
        isNotRevokedUser() &&
        isNotSuspendedOrRevokedMember(accountId) &&
        (
          hasActiveAccountMemberDoc(accountId) ||
          request.auth.token.get('activeAccountId', '') == accountId ||
          request.auth.token.get('tenantId', '') == accountId ||
          (
            exists(/databases/$(database)/documents/accounts/$(accountId)) &&
            get(/databases/$(database)/documents/accounts/$(accountId)).data.get('ownerId', '') == request.auth.uid
          )
        );
    }

    // 4º y 5º Jerarquía Soberana — Pertenencia estricta a cuenta B2B / EDU, sandbox propio 3º TEST-PILOT o Gobierno 1º DEV / 2º ADMIN
    function isAccountMember(accountId) {
      return accountId is string &&
        accountId.size() > 0 &&
        accountId.size() <= 128 &&
        (isDirectAccountMember(accountId) || isMatchingTestPilotSandbox(accountId) || isSystemPrivileged());
    }

    // Administración Interna de Cuenta / Tenant (Global Admin, Titular ownerId, o Miembro ACTIVO/Claim vigente con rol OWNER/ADMIN; excluye TEST_PILOT y suspendidos/revocados)
    function isTenantAdminOrOwner(tenantId) {
      return request.auth != null &&
        tenantId is string &&
        tenantId.size() > 0 &&
        tenantId.size() <= 128 &&
        (
          isAdmin() ||
          (
            !isPilotIdentity() &&
            isNotRevokedUser() &&
            isNotSuspendedOrRevokedMember(tenantId) &&
            (
              (
                hasActiveAccountMemberDoc(tenantId) &&
                get(/databases/$(database)/documents/accounts/$(tenantId)/members/$(request.auth.uid)).data.get('role', '') in ['OWNER', 'ADMIN']
              ) ||
              (
                exists(/databases/$(database)/documents/accounts/$(tenantId)) &&
                get(/databases/$(database)/documents/accounts/$(tenantId)).data.get('ownerId', '') == request.auth.uid
              ) ||
              (
                !exists(/databases/$(database)/documents/accounts/$(tenantId)/members/$(request.auth.uid)) &&
                (
                  request.auth.token.get('activeAccountId', '') == tenantId ||
                  request.auth.token.get('tenantId', '') == tenantId
                ) &&
                request.auth.token.get('role', '') in ['OWNER', 'ADMIN']
              )
            )
          )
        );
    }

    // Alias semánticos de privilegio administrativo interno de cuenta
    function isAccountAdmin(accountId) {
      return isTenantAdminOrOwner(accountId);
    }

    function hasAccountAdminPrivilege(tenantId) {
      return isTenantAdminOrOwner(tenantId);
    }

    // Predicado compartido 5º EDU Sandbox (alineado con restricciones en /accounts/{accountId})
    function isEduAccountData(data) {
      return data is map && (
        ('isEduSandbox' in data && data.isEduSandbox == true) ||
        ('classification' in data && data.classification in ['edu', 'educational']) ||
        ('type' in data && data.type == 'EDUCATIONAL')
      );
    }

    // Verifica si la cuenta /accounts/{accountId} corresponde a un Sandbox Académico 5º EDU
    function isAccountEduSandbox(accountId) {
      return accountId is string &&
        accountId.size() > 0 &&
        accountId.size() <= 128 &&
        exists(/databases/$(database)/documents/accounts/$(accountId)) &&
        isEduAccountData(get(/databases/$(database)/documents/accounts/$(accountId)).data);
    }

    // Verifica claims de rol/clasificación académica 5º EDU en el token del solicitante
    function isCallerEduRoleOrClassification() {
      return request.auth != null && (
        ('classification' in request.auth.token && request.auth.token.classification in ['edu', 'educational']) ||
        ('role' in request.auth.token && request.auth.token.role in ['STUDENT', 'PROFESSOR']) ||
        ('accountTier' in request.auth.token && request.auth.token.accountTier == 5) ||
        ('tier' in request.auth.token && request.auth.token.tier == 'EDUCATIONAL')
      );
    }

    // ===============================================================
    // 2. Helpers Multi-Tenant y Validadores de Dominio (Anti-DoS)
    // ===============================================================

    // Extrae identificador multi-tenant soportando tenantId, tenant_id y accountId
    function docTenantId(data) {
      let tid = data.get('tenantId', null);
      let tidS = data.get('tenant_id', null);
      let aid = data.get('accountId', null);
      return (tid is string && tid.size() > 0)
        ? tid
        : ((tidS is string && tidS.size() > 0) ? tidS : ((aid is string && aid.size() > 0) ? aid : null));
    }

    // Impide ataques de confusión entre llaves multi-tenant en un mismo documento
    function isConsistentTenantFields(data) {
      let tid = data.get('tenantId', null);
      let tidS = data.get('tenant_id', null);
      let aid = data.get('accountId', null);
      return (tid == null || (tid is string && tid.size() > 0 && tid.size() <= 128)) &&
        (tidS == null || (tidS is string && tidS.size() > 0 && tidS.size() <= 128)) &&
        (aid == null || (aid is string && aid.size() > 0 && aid.size() <= 128)) &&
        (tid == null || tidS == null || tid == tidS) &&
        (tid == null || aid == null || tid == aid) &&
        (tidS == null || aid == null || tidS == aid);
    }

    // Evalúa pertenencia e inmutabilidad multi-tenant evaluando docTenantId y membresía directa (o sandbox propio TEST-PILOT) una sola vez
    // (evita re-evaluar isSystemPrivileged cuando la regla llamante ya lo comprobó antes)
    function isTenantMatchCreate(newData) {
      let tid = docTenantId(newData);
      return tid is string && (isDirectAccountMember(tid) || isMatchingTestPilotSandbox(tid));
    }

    function isTenantMatchUpdate(oldData, newData) {
      let oldTid = docTenantId(oldData);
      return oldTid is string &&
        (isDirectAccountMember(oldTid) || isMatchingTestPilotSandbox(oldTid)) &&
        docTenantId(newData) == oldTid;
    }

    function isMeasurementCreateTenantValid(stkId, newData) {
      let tid = docTenantId(newData);
      return tid is string &&
        (isDirectAccountMember(tid) || isMatchingTestPilotSandbox(tid)) &&
        (
          !exists(/databases/$(database)/documents/stockpiles/$(stkId)) ||
          tid == docTenantId(get(/databases/$(database)/documents/stockpiles/$(stkId)).data)
        );
    }

    // Evalúa lectura multi-tenant alineada con el planificador estático de queries de Firestore
    function canReadTenantDoc(data) {
      return (docTenantId(data) is string && isAccountMember(docTenantId(data))) ||
        ('tenantId' in data && data.tenantId is string && isAccountMember(data.tenantId)) ||
        ('tenant_id' in data && data.tenant_id is string && isAccountMember(data.tenant_id)) ||
        ('accountId' in data && data.accountId is string && isAccountMember(data.accountId));
    }

    // Evalúa lectura de auditoría por tenant exclusiva para OWNER/ADMIN sin cruce multi-tenant ni shard global
    function isAuditableTenantId(tid) {
      return tid is string &&
        tid.size() > 0 &&
        tid.size() <= 128 &&
        !(tid in ['global', 'GLOBAL', 'dev-master-sandbox', 'admin-master-console']);
    }

    function canReadTenantAuditDoc(data) {
      return 'tenantId' in data &&
        isAuditableTenantId(data.tenantId) &&
        isTenantAdminOrOwner(data.tenantId);
    }

    // Validador general de cotas anti-DoS para colecciones operativas multi-tenant (Create & Update)
    function isBoundedPayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 200 &&
        isConsistentTenantFields(data) &&
        isOptCalStr(data, 'observations', 20000) &&
        isOptCalStr(data, 'notas', 20000);
    }

    // Validador de dominio para perfiles en /users/{userId} (Create & Update)
    function isValidUserProfilePayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 60 &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 200)) &&
        (!('firstName' in data) || data.firstName == null || (data.firstName is string && data.firstName.size() <= 120)) &&
        (!('lastName' in data) || data.lastName == null || (data.lastName is string && data.lastName.size() <= 120)) &&
        (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 200)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
        (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 2048)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        (!('preferredLanguage' in data) || data.preferredLanguage == null || (data.preferredLanguage is string && data.preferredLanguage.size() <= 16)) &&
        (!('language' in data) || data.language == null || (data.language is string && data.language.size() <= 16)) &&
        (!('theme' in data) || data.theme == null || (data.theme is string && data.theme.size() <= 32)) &&
        (!('lastActiveAccountId' in data) || data.lastActiveAccountId == null || (data.lastActiveAccountId is string && data.lastActiveAccountId.size() <= 128)) &&
        (!('preferences' in data) || data.preferences == null || (data.preferences is map && data.preferences.keys().size() <= 50));
    }

    // Validador de dominio para actualización de perfil comercial en /accounts/{accountId}
    function isValidAccountPayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 80 &&
        (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 250)) &&
        (!('fantasyName' in data) || data.fantasyName == null || (data.fantasyName is string && data.fantasyName.size() <= 250)) &&
        (!('nombreFantasia' in data) || data.nombreFantasia == null || (data.nombreFantasia is string && data.nombreFantasia.size() <= 250)) &&
        (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 300)) &&
        (!('direccionComercial' in data) || data.direccionComercial == null || (data.direccionComercial is string && data.direccionComercial.size() <= 300)) &&
        (!('direccionSucursal' in data) || data.direccionSucursal == null || (data.direccionSucursal is string && data.direccionSucursal.size() <= 300)) &&
        (!('commune' in data) || data.commune == null || (data.commune is string && data.commune.size() <= 120)) &&
        (!('region' in data) || data.region == null || (data.region is string && data.region.size() <= 120)) &&
        (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 120)) &&
        (!('country' in data) || data.country == null || (data.country is string && data.country.size() <= 120)) &&
        (!('postal_code' in data) || data.postal_code == null || (data.postal_code is string && data.postal_code.size() <= 32)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
        (!('telefonoPrincipal' in data) || data.telefonoPrincipal == null || (data.telefonoPrincipal is string && data.telefonoPrincipal.size() <= 50)) &&
        (!('telefonoSecundario' in data) || data.telefonoSecundario == null || (data.telefonoSecundario is string && data.telefonoSecundario.size() <= 50)) &&
        (!('contactEmail' in data) || data.contactEmail == null || (data.contactEmail is string && data.contactEmail.size() <= 254)) &&
        (!('emailComercial' in data) || data.emailComercial == null || (data.emailComercial is string && data.emailComercial.size() <= 254)) &&
        (!('emailTributario' in data) || data.emailTributario == null || (data.emailTributario is string && data.emailTributario.size() <= 254)) &&
        (!('email_domain' in data) || data.email_domain == null || (data.email_domain is string && data.email_domain.size() <= 120)) &&
        (!('giro' in data) || data.giro == null || (data.giro is string && data.giro.size() <= 300)) &&
        (!('activity' in data) || data.activity == null || (data.activity is string && data.activity.size() <= 300)) &&
        (!('geoFix' in data) || data.geoFix == null || (
          data.geoFix is map &&
          data.geoFix.keys().size() <= 16 &&
          'lat' in data.geoFix && data.geoFix.lat is number && data.geoFix.lat >= -90 && data.geoFix.lat <= 90 &&
          'lng' in data.geoFix && data.geoFix.lng is number && data.geoFix.lng >= -180 && data.geoFix.lng <= 180 &&
          (!('altitudeM' in data.geoFix) || data.geoFix.altitudeM == null || (data.geoFix.altitudeM is number && data.geoFix.altitudeM >= -1000 && data.geoFix.altitudeM <= 12000)) &&
          (!('accuracyM' in data.geoFix) || data.geoFix.accuracyM == null || (data.geoFix.accuracyM is number && data.geoFix.accuracyM >= 0 && data.geoFix.accuracyM <= 100000)) &&
          (!('headingDeg' in data.geoFix) || data.geoFix.headingDeg == null || (data.geoFix.headingDeg is number && data.geoFix.headingDeg >= 0 && data.geoFix.headingDeg <= 360)) &&
          (!('speedMps' in data.geoFix) || data.geoFix.speedMps == null || (data.geoFix.speedMps is number && data.geoFix.speedMps >= 0 && data.geoFix.speedMps <= 100000)) &&
          (!('capturedAt' in data.geoFix) || data.geoFix.capturedAt is timestamp || (data.geoFix.capturedAt is string && data.geoFix.capturedAt.size() <= 64)) &&
          (!('source' in data.geoFix) || (data.geoFix.source is string && data.geoFix.source.size() <= 64)) &&
          (!('srid' in data.geoFix) || data.geoFix.srid == 'EPSG:4326') &&
          (!('utm' in data.geoFix) || (
            data.geoFix.utm is map &&
            data.geoFix.utm.keys().size() <= 12 &&
            (!('zone' in data.geoFix.utm) || (data.geoFix.utm.zone is int && data.geoFix.utm.zone >= 1 && data.geoFix.utm.zone <= 60)) &&
            (!('band' in data.geoFix.utm) || (data.geoFix.utm.band is string && data.geoFix.utm.band.size() <= 8)) &&
            (!('hemisphere' in data.geoFix.utm) || data.geoFix.utm.hemisphere in ['N', 'S']) &&
            (!('eastingM' in data.geoFix.utm) || (data.geoFix.utm.eastingM is number && data.geoFix.utm.eastingM >= 0 && data.geoFix.utm.eastingM <= 1000000)) &&
            (!('northingM' in data.geoFix.utm) || (data.geoFix.utm.northingM is number && data.geoFix.utm.northingM >= 0 && data.geoFix.utm.northingM <= 10000000)) &&
            (!('datum' in data.geoFix.utm) || (data.geoFix.utm.datum is string && data.geoFix.utm.datum.size() <= 32)) &&
            (!('epsg' in data.geoFix.utm) || (data.geoFix.utm.epsg is string && data.geoFix.utm.epsg.size() <= 32)) &&
            (!('formatted' in data.geoFix.utm) || (data.geoFix.utm.formatted is string && data.geoFix.utm.formatted.size() <= 128))
          ))
        )) &&
        (!('corporateLogo' in data) || data.corporateLogo == null || (
          data.corporateLogo is map &&
          data.corporateLogo.keys().size() <= 12 &&
          'sha256' in data.corporateLogo && data.corporateLogo.sha256 is string && data.corporateLogo.sha256.size() == 64 && data.corporateLogo.sha256.matches('^[a-f0-9]{64}$') &&
          'downloadUrl' in data.corporateLogo && data.corporateLogo.downloadUrl is string && data.corporateLogo.downloadUrl.size() > 0 && data.corporateLogo.downloadUrl.size() <= 512 && data.corporateLogo.downloadUrl.matches('^(/api/media/|https://).*') &&
          'mimeType' in data.corporateLogo && data.corporateLogo.mimeType is string && data.corporateLogo.mimeType.size() > 0 && data.corporateLogo.mimeType.size() <= 64 &&
          'originalBytes' in data.corporateLogo && data.corporateLogo.originalBytes is number && data.corporateLogo.originalBytes >= 0 && data.corporateLogo.originalBytes <= 104857600 &&
          'optimizedBytes' in data.corporateLogo && data.corporateLogo.optimizedBytes is number && data.corporateLogo.optimizedBytes >= 0 && data.corporateLogo.optimizedBytes <= 20971520 &&
          'savingsPct' in data.corporateLogo && data.corporateLogo.savingsPct is number && data.corporateLogo.savingsPct >= 0 && data.corporateLogo.savingsPct <= 100 &&
          (!('profile' in data.corporateLogo) || data.corporateLogo.profile in ['IMAGE_ISO_SYMBOL', 'VECTOR_SVG_CLEAN']) &&
          (!('extension' in data.corporateLogo) || (data.corporateLogo.extension is string && data.corporateLogo.extension.size() <= 16)) &&
          (!('updatedAt' in data.corporateLogo) || data.corporateLogo.updatedAt is number || data.corporateLogo.updatedAt is timestamp || (data.corporateLogo.updatedAt is string && data.corporateLogo.updatedAt.size() <= 64))
        )) &&
        (!('coBrandingLogoUrl' in data) || data.coBrandingLogoUrl == null || (
          data.coBrandingLogoUrl is string &&
          data.coBrandingLogoUrl.size() <= 512 &&
          (data.coBrandingLogoUrl == '' || data.coBrandingLogoUrl.matches('^(/api/media/|https://).*'))
        ));
    }

    // Validador estructural y prevención de DoS para colecciones técnicas OPERMAQ / Plan Maestro v4.0
    function isValidOpermaqPayload(data) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 120 &&
        isConsistentTenantFields(data) &&
        (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 500)) &&
        (!('content' in data) || data.content == null || (data.content is string && data.content.size() <= 900000)) &&
        (!('notas' in data) || data.notas == null || (data.notas is string && data.notas.size() <= 10000)) &&
        (!('observations' in data) || data.observations == null || (data.observations is string && data.observations.size() <= 10000)) &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 10000)) &&
        (!('messages' in data) || data.messages == null || (data.messages is list && data.messages.size() <= 500));
    }

    // Validador de dominio para Anillo A (/accounts/{accountId}/manufacturer_contacts/{contactId})
    function isValidManufacturerContactPayload(data, accountId, contactId) {
      return isBoundedPayload(data) &&
        data.keys().hasOnly([
          'contactId',
          'tenantId',
          'supplierKey',
          'manufacturerKey',
          'distributorName',
          'areaName',
          'areaKey',
          'contactLabel',
          'channelType',
          'cityRegion',
          'phone',
          'emailOrWeb',
          'notes',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        ('tenantId' in data && data.tenantId is string && data.tenantId == accountId) &&
        (!('contactId' in data) || (data.contactId is string && data.contactId.size() > 0 && data.contactId.size() <= 256 && data.contactId == contactId)) &&
        (!('supplierKey' in data) || data.supplierKey == null || (data.supplierKey is string && data.supplierKey.size() <= 120)) &&
        (!('manufacturerKey' in data) || data.manufacturerKey == null || (data.manufacturerKey is string && data.manufacturerKey.size() <= 120)) &&
        (!('distributorName' in data) || data.distributorName == null || (data.distributorName is string && data.distributorName.size() <= 180)) &&
        (!('areaName' in data) || data.areaName == null || (data.areaName is string && data.areaName.size() <= 120)) &&
        (!('areaKey' in data) || data.areaKey == null || (data.areaKey is string && data.areaKey.size() <= 120)) &&
        (!('contactLabel' in data) || data.contactLabel == null || (data.contactLabel is string && data.contactLabel.size() <= 160)) &&
        (!('channelType' in data) || data.channelType == null || (data.channelType is string && data.channelType in ['NEW', 'USED', 'RENTAL', 'PARTS', 'SERVICE'])) &&
        (!('cityRegion' in data) || data.cityRegion == null || (data.cityRegion is string && data.cityRegion.size() <= 120)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 64)) &&
        (!('emailOrWeb' in data) || data.emailOrWeb == null || (data.emailOrWeb is string && data.emailOrWeb.size() <= 512)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 20000)) &&
        (!('createdByUid' in data) || (data.createdByUid is string && data.createdByUid.size() > 0 && data.createdByUid.size() <= 128)) &&
        (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is number || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp || data.updatedAt is number || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validador de dominio para reglas privadas de facturación DTE / Ley N° 21.131 (/accounts/{accountId}/supplier_billing_rules/{supplierKey})
    function isValidSupplierBillingRulePayload(data, accountId, ruleSupplierKey) {
      return data is map &&
        data.keys().hasOnly([
          'tenantId',
          'supplierKey',
          'requiresPurchaseOrder801',
          'requiresContract803',
          'requiresDispatchGuide52',
          'requiresReceptionTokenType',
          'defaultFormaPagoDte',
          'paymentTermDays',
          'hasExceptionalPaymentAgreement',
          'exceptionalAgreementNote',
          'dteClaimWindowDays',
          'rcvClaimAlertEmail',
          'allowFactoringCesion',
          'billingPortalUrl',
          'remittanceEmail',
          'defaultCentroCosto',
          'notes',
          'updatedByUid',
          'updatedAt'
        ]) &&
        ('tenantId' in data && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128 && data.tenantId == accountId) &&
        ('supplierKey' in data && data.supplierKey is string && data.supplierKey.size() > 0 && data.supplierKey.size() <= 120 && data.supplierKey == ruleSupplierKey) &&
        ('requiresPurchaseOrder801' in data && data.requiresPurchaseOrder801 is bool) &&
        ('requiresContract803' in data && data.requiresContract803 is bool) &&
        ('requiresDispatchGuide52' in data && data.requiresDispatchGuide52 is bool) &&
        ('requiresReceptionTokenType' in data && data.requiresReceptionTokenType is string && data.requiresReceptionTokenType in ['NONE', 'HES', 'HEM', 'HAS']) &&
        ('defaultFormaPagoDte' in data && data.defaultFormaPagoDte is int && data.defaultFormaPagoDte in [1, 2, 3]) &&
        ('paymentTermDays' in data && data.paymentTermDays is int && data.paymentTermDays >= 0 && data.paymentTermDays <= 365) &&
        ('hasExceptionalPaymentAgreement' in data && data.hasExceptionalPaymentAgreement is bool) &&
        (data.paymentTermDays <= 30 || data.hasExceptionalPaymentAgreement == true) &&
        ('dteClaimWindowDays' in data && data.dteClaimWindowDays is int && data.dteClaimWindowDays >= 1 && data.dteClaimWindowDays <= 8) &&
        ('allowFactoringCesion' in data && data.allowFactoringCesion is bool) &&
        ('updatedAt' in data && data.updatedAt is int && data.updatedAt >= 0) &&
        (!('exceptionalAgreementNote' in data) || data.exceptionalAgreementNote == null || (data.exceptionalAgreementNote is string && data.exceptionalAgreementNote.size() <= 240)) &&
        (!('rcvClaimAlertEmail' in data) || data.rcvClaimAlertEmail == null || (data.rcvClaimAlertEmail is string && data.rcvClaimAlertEmail.size() <= 180)) &&
        (!('billingPortalUrl' in data) || data.billingPortalUrl == null || (data.billingPortalUrl is string && data.billingPortalUrl.size() <= 512)) &&
        (!('remittanceEmail' in data) || data.remittanceEmail == null || (data.remittanceEmail is string && data.remittanceEmail.size() <= 180)) &&
        (!('defaultCentroCosto' in data) || data.defaultCentroCosto == null || (data.defaultCentroCosto is string && data.defaultCentroCosto.size() <= 80)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 800)) &&
        (!('updatedByUid' in data) || data.updatedByUid == null || (data.updatedByUid is string && data.updatedByUid.size() <= 128));
    }

    // Rechazo barato de data: URLs sin regex PCRE costoso (STOCKPILE CONTROL Next-Gen)
    function isNoDataUrlPrefix(s) {
      let t = s.trim();
      return t.size() < 5 || t[0:5].lower() != 'data:';
    }

    function isSafeUrlField(d, k) {
      let v = d.get(k, null);
      return v == null || (v is string && v.size() <= 2048 && isNoDataUrlPrefix(v));
    }

    function isOptCalStr(d, k, maxLen) {
      let v = d.get(k, null);
      return v == null || (v is string && v.size() <= maxLen);
    }

    function isOptNonNegNum(d, k) {
      let v = d.get(k, null);
      return v == null || (v is number && v >= 0);
    }

    // Validador ultra-compacto de dominio para acopios en /stockpiles/{stkId} (STOCKPILE CONTROL Next-Gen — Create & Update)
    function isValidStockpilePayload(data) {
      let name = data.get('name', null);
      let vol = data.get('last_volume_m3', null);
      let weight = data.get('last_weight_t', null);
      let perim = data.get('perimeter_photo_urls', null);
      return isBoundedPayload(data) &&
        data.get('clase', null) in [null, 'mineral', 'esteril', 'baja_ley'] &&
        data.get('status', null) in [null, 'ACTIVE', 'ARCHIVED', 'CONCILIATED', 'CLOSED'] &&
        data.get('closure_reason', null) in [null, 'SHIPPED', 'FIELD_REMOVED', 'ZERO_VOLUME', 'MANUAL_CLOSE'] &&
        isOptCalStr(data, 'closure_cause', 300) &&
        data.get('closure_origin', null) in [null, 'MOBILE_FIELD'] &&
        isOptCalStr(data, 'dispatch_transport', 200) &&
        isOptCalStr(data, 'dispatch_destination', 200) &&
        isOptNonNegNum(data, 'dispatch_timestamp') &&
        (name == null || (name is string && name.size() <= 240)) &&
        isSafeUrlField(data, 'initial_photo_url') &&
        isSafeUrlField(data, 'last_photo_url') &&
        isSafeUrlField(data, 'thumbnail_url') &&
        isSafeUrlField(data, 'static_map_url') &&
        isSafeUrlField(data, 'mesh_url') &&
        (vol == null || (vol is number && vol >= 0)) &&
        (weight == null || (weight is number && weight >= 0)) &&
        (perim == null || (perim is list && perim.size() <= 32));
    }

    // Validador ultra-compacto de dominio para mediciones en /stockpiles/{stkId}/measurements/{measId} (STOCKPILE CONTROL Next-Gen — Create & Update)
    function isValidStockpileMeasurementPayload(data) {
      let vol = data.get('volumen_m3', null);
      let peso = data.get('peso_t', null);
      let perim = data.get('perimeter_photo_urls', null);
      return isBoundedPayload(data) &&
        data.get('method', null) in [null, 'digital', 'manual'] &&
        data.get('closure_reason', null) in [null, 'SHIPPED', 'FIELD_REMOVED', 'ZERO_VOLUME', 'MANUAL_CLOSE'] &&
        isOptCalStr(data, 'closure_cause', 300) &&
        data.get('closure_origin', null) in [null, 'MOBILE_FIELD'] &&
        isOptCalStr(data, 'dispatch_transport', 200) &&
        isOptCalStr(data, 'dispatch_destination', 200) &&
        isOptNonNegNum(data, 'dispatch_timestamp') &&
        (!('volumen_m3' in data) || (vol is number && vol >= 0)) &&
        (!('peso_t' in data) || (peso is number && peso >= 0)) &&
        isSafeUrlField(data, 'photo_url') &&
        isSafeUrlField(data, 'previous_photo_url') &&
        isSafeUrlField(data, 'mesh_url') &&
        (perim == null || (perim is list && perim.size() <= 32));
    }

    // Validador compacto de calibración on-demand en /device_calibrations/{calId} (R5 — Create)
    function isValidDeviceCalibrationPayload(data) {
      return data is map &&
        data.keys().size() <= 40 &&
        data.keys().hasAll(['scaleFactor', 'referenceDistanceM', 'measuredDistanceM', 'calibratedAt']) &&
        !('actorEmail' in data) &&
        !('email' in data) &&
        !('ipAddress' in data) &&
        data.scaleFactor is number &&
        data.scaleFactor >= 0.85 &&
        data.scaleFactor <= 1.15 &&
        data.referenceDistanceM is number &&
        data.referenceDistanceM > 0 &&
        data.referenceDistanceM <= 1000 &&
        data.measuredDistanceM is number &&
        data.measuredDistanceM > 0 &&
        data.measuredDistanceM <= 1000 &&
        data.calibratedAt is number &&
        data.calibratedAt > 0 &&
        (data.get('id', null) == null || (data.id is string && data.id.size() > 0 && data.id.size() <= 128)) &&
        (data.get('tenantId', null) == null || (data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 128)) &&
        isOptCalStr(data, 'calibrationId', 128) &&
        isOptCalStr(data, 'deviceId', 160) &&
        isOptCalStr(data, 'deviceModel', 160) &&
        isOptCalStr(data, 'platform', 32) &&
        isOptCalStr(data, 'calibratedBy', 160) &&
        isOptCalStr(data, 'userId', 160) &&
        isOptCalStr(data, 'actorUid', 160) &&
        isOptCalStr(data, 'region', 64) &&
        (data.get('planeNoiseRmsM', null) == null || (data.planeNoiseRmsM is number && data.planeNoiseRmsM >= 0 && data.planeNoiseRmsM <= 100)) &&
        (data.get('imuPitchOffsetDeg', null) == null || (data.imuPitchOffsetDeg is number && data.imuPitchOffsetDeg >= -180 && data.imuPitchOffsetDeg <= 180)) &&
        (data.get('imuRollOffsetDeg', null) == null || (data.imuRollOffsetDeg is number && data.imuRollOffsetDeg >= -180 && data.imuRollOffsetDeg <= 180)) &&
        (data.get('createdAt', null) == null || data.createdAt is timestamp || (data.createdAt is number && data.createdAt >= 0));
    }

    // ---------------------------------------------------------------
    // Helpers y Validadores de Dominio — MINREPORT · ABASTECIMIENTO (`supply`)
    // ---------------------------------------------------------------

    // Layout B: verifica si `tenantId` corresponde al sandbox propio declarado en /test_pilots/{uid}
    // (`pilot-{uid}` o `pilotAccountId`/`accountId` registrado bajo prefijo `pilot-`)
    function matchesUidKeyedPilotSandboxData(pilotData, tenantId) {
      return pilotData is map &&
        (
          tenantId == ('pilot-' + request.auth.uid) ||
          (
            'pilotAccountId' in pilotData &&
            isPilotAccountIdFormat(pilotData.pilotAccountId) &&
            tenantId == pilotData.pilotAccountId
          ) ||
          (
            'accountId' in pilotData &&
            isPilotAccountIdFormat(pilotData.accountId) &&
            tenantId == pilotData.accountId
          )
        );
    }

    function matchesUidKeyedPilotSandbox(tenantId) {
      return isValidUidKeyedTestPilotDoc() &&
        matchesUidKeyedPilotSandboxData(
          get(/databases/$(database)/documents/test_pilots/$(request.auth.uid)).data,
          tenantId
        );
    }

    // Verifica pertenencia hermética de 3º TEST-PILOT exclusivamente a su propio sandbox `pilot-*`
    // Soporta Layout A real (`dev.controller.ts`: `/test_pilots/{tenantId}` con `userId == uid` y `status == 'ACTIVE'`)
    // y Layout B legacy/tests (`/test_pilots/{uid}` con `tenantId == 'pilot-' + uid` o `pilotAccountId`/`accountId` registrado)
    // (impide cruce hacia datos B2B/EDU, hacia sandboxes `pilot-*` de terceros o con membresía suspendida/revocada)
    function isMatchingTestPilotSandbox(tenantId) {
      return isTestPilot() &&
        isPilotAccountIdFormat(tenantId) &&
        isNotSuspendedOrRevokedMember(tenantId) &&
        (
          isValidAccountKeyedTestPilotDoc(tenantId) ||
          matchesUidKeyedPilotSandbox(tenantId)
        );
    }

    // Determina si un SKU de /global_supply_catalog/{skuId} es público global
    // (sin tenantId/tenant_id/accountId no vacío y sin marca privada TENANT_PRIVATE/TENANT)
    function isGlobalSupplyCatalogPublicDoc(data) {
      return data is map &&
        !(data.get('scope', '') in ['TENANT_PRIVATE', 'TENANT']) &&
        (!('tenantId' in data) || data.tenantId == null || data.tenantId == '') &&
        (!('tenant_id' in data) || data.tenant_id == null || data.tenant_id == '') &&
        (!('accountId' in data) || data.accountId == null || data.accountId == '');
    }

    // Lectura multi-tenant hermética para colecciones operativas de ABASTECIMIENTO (`tenantId` obligatorio)
    // Permite miembro directo ACTIVO B2B/EDU del tenant o 3º TEST-PILOT hermético exclusivamente en su propio sandbox `pilot-*`
    // (1º DEV / 2º ADMIN se evalúan antes mediante isAdmin() para soportar get sobre docs inexistentes)
    function canReadSupplyTenantDoc(data) {
      return data is map &&
        'tenantId' in data &&
        data.tenantId is string &&
        data.tenantId.size() > 0 &&
        data.tenantId.size() <= 128 &&
        (
          isDirectAccountMember(data.tenantId) ||
          isMatchingTestPilotSandbox(data.tenantId)
        );
    }

    // Lectura tenant-scoped de auditoría de políticas ABASTECIMIENTO exclusiva OWNER/ADMIN ACTIVO (sin cruce ni TEST_PILOT)
    function canReadSupplyPolicyAuditDoc(data) {
      return data is map &&
        'tenantId' in data &&
        isAuditableTenantId(data.tenantId) &&
        !isPilotIdentity() &&
        isTenantAdminOrOwner(data.tenantId);
    }

    function isOptValidSupplyTimestamp(d, k) {
      let v = d.get(k, null);
      return v == null ||
        v is timestamp ||
        (v is number && v >= 0) ||
        (v is string && v.size() > 0 && v.size() <= 64);
    }

    // Bloquea tenantId/scope privado no controlado y campos PII (Ley N° 19.628 y N° 21.719) en catálogo maestro global
    function hasNoGlobalCatalogForbiddenKeys(data) {
      return !data.keys().hasAny([
        'tenantId',
        'tenant_id',
        'accountId',
        'account_id',
        'ownerTenantId',
        'organizationId',
        'rut',
        'run',
        'taxId',
        'supplierTaxId',
        'rutProveedor',
        'phone',
        'phoneE164',
        'telefono',
        'mobile',
        'whatsapp',
        'email',
        'contactEmail',
        'actorEmail',
        'correo',
        'ppu',
        'patente',
        'licensePlate',
        'gps',
        'geoFix',
        'lat',
        'lng',
        'latitude',
        'longitude',
        'coordinates',
        'address',
        'direccion',
        'ipAddress',
        'contractNumber',
        'purchaseOrderNumber'
      ]) && (!('scope' in data) || data.scope == null || data.scope in ['GLOBAL', 'GLOBAL_COMMONS']);
    }

    function hasValidGlobalCatalogTextFields(data, skuId) {
      return (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 128 && data.id == skuId)) &&
        (!('skuId' in data) || (data.skuId is string && data.skuId.size() > 0 && data.skuId.size() <= 128 && data.skuId == skuId)) &&
        (!('canonicalSkuId' in data) || (data.canonicalSkuId is string && data.canonicalSkuId.size() > 0 && data.canonicalSkuId.size() <= 128)) &&
        isOptCalStr(data, 'sku', 128) &&
        isOptCalStr(data, 'skuCode', 128) &&
        isOptCalStr(data, 'name', 240) &&
        isOptCalStr(data, 'nameEs', 240) &&
        isOptCalStr(data, 'canonicalName', 240) &&
        isOptCalStr(data, 'canonicalNameEs', 240) &&
        isOptCalStr(data, 'title', 240) &&
        (
          (data.get('name', null) is string && data.name.size() > 0) ||
          (data.get('nameEs', null) is string && data.nameEs.size() > 0) ||
          (data.get('canonicalName', null) is string && data.canonicalName.size() > 0) ||
          (data.get('canonicalNameEs', null) is string && data.canonicalNameEs.size() > 0) ||
          (data.get('title', null) is string && data.title.size() > 0)
        ) &&
        isOptCalStr(data, 'description', 2000) &&
        isOptCalStr(data, 'category', 120) &&
        isOptCalStr(data, 'categoryCode', 64) &&
        isOptCalStr(data, 'procurementBucket', 64) &&
        isOptCalStr(data, 'subcategory', 120) &&
        isOptCalStr(data, 'family', 120) &&
        isOptCalStr(data, 'unit', 32) &&
        isOptCalStr(data, 'uom', 32) &&
        isOptCalStr(data, 'unitOfMeasure', 32) &&
        isOptCalStr(data, 'baseUnitSi', 32) &&
        isOptCalStr(data, 'defaultCostCenter', 64) &&
        isOptCalStr(data, 'slotQuestionTemplate', 500) &&
        isOptCalStr(data, 'unspscCode', 32) &&
        isOptCalStr(data, 'partNumber', 120) &&
        isOptCalStr(data, 'oemPartNumber', 120) &&
        isOptCalStr(data, 'manufacturer', 180) &&
        isOptCalStr(data, 'manufacturerKey', 120) &&
        isOptCalStr(data, 'brand', 120) &&
        isOptCalStr(data, 'currency', 16) &&
        isOptCalStr(data, 'status', 32) &&
        isOptCalStr(data, 'notes', 2000) &&
        isOptCalStr(data, 'observations', 2000);
    }

    function hasValidGlobalCatalogNumericAndMetaFields(data) {
      return isSafeUrlField(data, 'imageUrl') &&
        isSafeUrlField(data, 'thumbnailUrl') &&
        isSafeUrlField(data, 'datasheetUrl') &&
        isOptNonNegNum(data, 'referencePriceClp') &&
        isOptNonNegNum(data, 'referencePriceUsd') &&
        isOptNonNegNum(data, 'referenceUnitPriceClp') &&
        isOptNonNegNum(data, 'estimatedUnitPriceClp') &&
        isOptNonNegNum(data, 'perPaxDailyBaseline') &&
        isOptNonNegNum(data, 'expectedDailyPerPaxSi') &&
        isOptNonNegNum(data, 'unitCost') &&
        isOptNonNegNum(data, 'unitWeightKg') &&
        isOptNonNegNum(data, 'leadTimeDays') &&
        (data.get('requiredSlots', null) == null || (data.requiredSlots is list && data.requiredSlots.size() <= 32)) &&
        (data.get('defaultPackToSi', null) == null ||
          (data.defaultPackToSi is number && data.defaultPackToSi > 0) ||
          (data.defaultPackToSi is map && data.defaultPackToSi.keys().size() <= 6)) &&
        (data.get('aliases', null) == null || (data.aliases is list && data.aliases.size() <= 50)) &&
        (data.get('tags', null) == null || (data.tags is list && data.tags.size() <= 50)) &&
        (data.get('searchTokens', null) == null || (data.searchTokens is list && data.searchTokens.size() <= 100)) &&
        (data.get('compatibleModels', null) == null || (data.compatibleModels is list && data.compatibleModels.size() <= 100)) &&
        (data.get('compatibleArchetypes', null) == null || (data.compatibleArchetypes is list && data.compatibleArchetypes.size() <= 32)) &&
        (data.get('specs', null) == null || (data.specs is map && data.specs.keys().size() <= 60)) &&
        (data.get('isCapexAsset', null) == null || data.isCapexAsset is bool) &&
        (data.get('isControlled', null) == null || data.isControlled is bool) &&
        (data.get('leySaco25kgApplied', null) == null || data.leySaco25kgApplied is bool) &&
        (data.get('active', null) == null || data.active is bool) &&
        (data.get('isActive', null) == null || data.isActive is bool) &&
        isOptValidSupplyTimestamp(data, 'createdAt') &&
        isOptValidSupplyTimestamp(data, 'updatedAt');
    }

    // Validador de dominio para catálogo maestro global /global_supply_catalog/{skuId} (Create & Update)
    // Bloquea tenantId/scope privado no controlado, PII chilena/estándar (Ley N° 19.628 y N° 21.719), data: Base64 y payloads sin cota (Anti-DoS)
    function isValidGlobalSupplyCatalogPayload(data, skuId) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 80 &&
        hasNoGlobalCatalogForbiddenKeys(data) &&
        hasValidGlobalCatalogTextFields(data, skuId) &&
        hasValidGlobalCatalogNumericAndMetaFields(data);
    }

    // Validador de dominio para presets globales de políticas /global_supply_policy_presets/{roleId} (Create & Update)
    function isValidGlobalSupplyPolicyPresetPayload(data, roleId) {
      return data is map &&
        data.keys().size() > 0 &&
        data.keys().size() <= 60 &&
        !('tenantId' in data) &&
        !('tenant_id' in data) &&
        !('accountId' in data) &&
        !('rut' in data) &&
        !('phone' in data) &&
        !('email' in data) &&
        !('gps' in data) &&
        !('geoFix' in data) &&
        (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 64 && data.id == roleId)) &&
        (!('roleId' in data) || (data.roleId is string && data.roleId.size() > 0 && data.roleId.size() <= 64 && data.roleId == roleId)) &&
        isOptCalStr(data, 'role', 64) &&
        isOptCalStr(data, 'roleName', 120) &&
        isOptCalStr(data, 'label', 120) &&
        isOptCalStr(data, 'name', 120) &&
        isOptCalStr(data, 'description', 1000) &&
        isOptCalStr(data, 'currency', 16) &&
        isOptCalStr(data, 'notes', 2000) &&
        isOptNonNegNum(data, 'maxApprovalAmountClp') &&
        isOptNonNegNum(data, 'maxApprovalAmountUsd') &&
        isOptNonNegNum(data, 'maxAutoApproveClp') &&
        isOptNonNegNum(data, 'maxSinglePurchaseClp') &&
        isOptNonNegNum(data, 'monthlyBudgetLimitClp') &&
        isOptNonNegNum(data, 'version') &&
        (data.get('permissions', null) == null ||
          (data.permissions is list && data.permissions.size() <= 100) ||
          (data.permissions is map && data.permissions.keys().size() <= 100)) &&
        (data.get('allowedActions', null) == null || (data.allowedActions is list && data.allowedActions.size() <= 100)) &&
        (data.get('rules', null) == null ||
          (data.rules is map && data.rules.keys().size() <= 60) ||
          (data.rules is list && data.rules.size() <= 60)) &&
        (data.get('limits', null) == null || (data.limits is map && data.limits.keys().size() <= 40)) &&
        (data.get('requiresHitlApproval', null) == null || data.requiresHitlApproval is bool) &&
        (data.get('isDefault', null) == null || data.isDefault is bool) &&
        (data.get('active', null) == null || data.active is bool) &&
        (data.get('isActive', null) == null || data.isActive is bool) &&
        isOptValidSupplyTimestamp(data, 'createdAt') &&
        isOptValidSupplyTimestamp(data, 'updatedAt');
    }

    // ===============================================================
    // 3. Identidad, PII, Passkeys WebAuthn, M2M x402 y Secretos
    // ===============================================================

    // Directorio de identificación RUT (Cero exposición PII a clientes comunes; resolución vía Admin SDK)
    match /user_directory/{run} {
      allow read, write: if isAdmin();
    }

    // Perfiles de usuario (Cero enumeración y bloqueo total de auto-escalamiento de rol/memberships)
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isOwner(userId) ||
        (userId == 'dev-master-root-uid' ? isDevRoot() : isAdmin())
      );
      allow list: if isAdmin();

      allow create: if isValidUserProfilePayload(request.resource.data) && (
        (userId == 'dev-master-root-uid' ? isDevRoot() : isAdmin()) ||
        (
          isOwner(userId) &&
          userId != 'dev-master-root-uid' &&
          userId != 'super-admin-uid' &&
          (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
          !('isMasterDev' in request.resource.data) &&
          !('admin' in request.resource.data) &&
          !('passwordHash' in request.resource.data) &&
          !('entitlements' in request.resource.data) &&
          !('status' in request.resource.data) &&
          !('accountTier' in request.resource.data) &&
          !('classification' in request.resource.data) &&
          (!('role' in request.resource.data) || request.resource.data.role in ['OPERATOR', 'VIEWER', 'STUDENT']) &&
          (!('memberships' in request.resource.data) ||
            (request.resource.data.memberships is list && request.resource.data.memberships.size() == 0))
        )
      );

      allow update: if isValidUserProfilePayload(request.resource.data) && (
        (userId == 'dev-master-root-uid' ? isDevRoot() : isAdmin()) ||
        (
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'firstName',
            'lastName',
            'name',
            'phone',
            'avatar',
            'photoURL',
            'preferences',
            'preferredLanguage',
            'language',
            'theme',
            'lastActiveAccountId',
            'updatedAt',
            'lastLoginAt'
          ])
        )
      );

      // Prohibición de purga para cuentas raíz soberanas
      allow delete: if isAdmin() && userId != 'dev-master-root-uid' && userId != 'super-admin-uid';

      // Mensajería y Notificaciones internas del usuario
      match /inbox/{messageId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create, update: if (isAdmin() || isOwner(userId)) && isBoundedPayload(request.resource.data);
        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    // Credenciales y secretos internos de autenticación (Exclusivo Admin SDK)
    match /user_auth_credentials/{userId} {
      allow read, write: if false;
    }

    // Llaves públicas Passkeys / WebAuthn FIDO2
    match /webauthn_credentials/{credId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && 'uid' in resource.data && resource.data.uid == request.auth.uid)
      );
      allow write: if false;
    }

    // Challenges efímeros WebAuthn FIDO2 (Exclusivo Admin SDK)
    match /webauthn_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Challenges y metadatos criptográficos de gateway DEV_ROOT (Exclusivo Admin SDK)
    match /dev_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Desafíos OTP de acceso 3 pasos en escritorio (Exclusivo Admin SDK)
    match /auth_otp_challenges/{challengeId} {
      allow read, write: if false;
    }

    // Tokens de configuración inicial de contraseña (Exclusivo Admin SDK)
    match /setup_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /system_dev_meta/{docId} {
      allow read, write: if false;
    }

    match /system_emails/{emailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Monetización M2M y Protocolo x402 (Escritura exclusiva Admin SDK)
    match /m2m_wallets/{walletId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /x402_receipts/{receiptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cabeza de cadena hash SHA-256 del Audit Ledger (Escritura exclusiva Admin SDK)
    match /audit_ledger_head/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Telemetría operativa del Enjambre Gemini IA
    match /ai_telemetry/{docId} {
      allow read: if isAdmin() || isTestPilot();
      allow write: if false;
    }

    // Logs administrativos internos del panel Super Admin (Append-Only)
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isBoundedPayload(request.resource.data);
      allow update, delete: if false;
    }

    // ===============================================================
    // 4. Cuentas Soberanas B2B / EDU, Miembros y Configuración Global
    // ===============================================================

    match /accounts/{accountId} {
      allow read: if isAuthenticated() && (
        isAccountMember(accountId) ||
        isAdmin() ||
        isSystemPrivileged() ||
        (resource != null && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (
          resource != null &&
          'primaryOperator' in resource.data &&
          resource.data.primaryOperator is map &&
          'email' in resource.data.primaryOperator &&
          'email' in request.auth.token &&
          resource.data.primaryOperator.email == request.auth.token.email
        )
      );

      // Alta exclusiva por servidor (/api/auth/register Admin SDK) o Super Admin / DevRoot
      allow create: if isAdmin() && isValidAccountPayload(request.resource.data);

      // Bloquea alteración cliente de contract, licensing, status, enabledPlugins, ownerId y cuentas sandbox 5º EDU
      allow update: if isValidAccountPayload(request.resource.data) && (
        isAdmin() ||
        (
          !('isEduSandbox' in resource.data && resource.data.isEduSandbox == true) &&
          !('classification' in resource.data && resource.data.classification in ['edu', 'educational']) &&
          !('type' in resource.data && resource.data.type == 'EDUCATIONAL') &&
          (
            ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
            isAccountAdmin(accountId)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'fantasyName',
            'nombreFantasia',
            'address',
            'direccionComercial',
            'direccionSucursal',
            'commune',
            'region',
            'city',
            'country',
            'postal_code',
            'phone',
            'telefonoPrincipal',
            'telefonoSecundario',
            'contactEmail',
            'emailComercial',
            'emailTributario',
            'email_domain',
            'giro',
            'activity',
            'branding',
            'corporateLogo',
            'coBrandingLogoUrl',
            'operationalSettings',
            'geoFix',
            'updatedAt'
          ])
        ) ||
        (
          resource != null &&
          'primaryOperator' in resource.data &&
          resource.data.primaryOperator is map &&
          resource.data.primaryOperator.status == 'PENDING' &&
          'email' in request.auth.token &&
          resource.data.primaryOperator.email == request.auth.token.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primaryOperator']) &&
          'primaryOperator' in request.resource.data &&
          request.resource.data.primaryOperator is map &&
          request.resource.data.primaryOperator.uid == request.auth.uid &&
          request.resource.data.primaryOperator.status == 'ACTIVE'
        )
      );

      allow delete: if isAdmin() && accountId != 'dev-master-sandbox';

      // Subcolección: Perfiles de Cargo por Cuenta (Bloqueo total cliente)
      match /job_profiles/{profileId} {
        allow read, write: if false;
      }

      // Subcolección: Miembros Internos (Lectura titular/cuenta/Admin; mutación exclusiva Admin SDK vía /api/staff/members)
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == memberId ||
          isAccountMember(accountId) ||
          isAdmin()
        );
        allow write: if false;
      }

      // Subcolección: Telemetría Atómica por Cliente y Periodo (Escritura exclusiva Admin SDK)
      match /metrics/{periodId} {
        allow read: if isAccountMember(accountId) || isAdmin();
        allow write: if false;
      }

      // Subcolección Anillo A — Agenda Privada Multi-Tenant Offline-First (OPERMAQ · FABRICANTES v2.0, Ley N° 21.719)
      match /manufacturer_contacts/{contactId} {
        allow read: if isAccountMember(accountId);
        allow create: if isAccountMember(accountId) &&
          isValidManufacturerContactPayload(request.resource.data, accountId, contactId) &&
          !(('isEduSandbox' in request.auth.token) && request.auth.token.isEduSandbox == true) &&
          !isCallerEduRoleOrClassification() &&
          !isAccountEduSandbox(accountId) &&
          ('tenantId' in request.resource.data && request.resource.data.tenantId == accountId) &&
          ('contactId' in request.resource.data && request.resource.data.contactId is string && request.resource.data.contactId == contactId) &&
          ('createdByUid' in request.resource.data && request.resource.data.createdByUid == request.auth.uid);
        allow update: if isAccountMember(accountId) &&
          isValidManufacturerContactPayload(request.resource.data, accountId, contactId) &&
          !(('isEduSandbox' in request.auth.token) && request.auth.token.isEduSandbox == true) &&
          !isCallerEduRoleOrClassification() &&
          !isAccountEduSandbox(accountId) &&
          ('tenantId' in request.resource.data && request.resource.data.tenantId == accountId) &&
          ('tenantId' in resource.data && resource.data.tenantId == accountId) &&
          (!('contactId' in resource.data) || ('contactId' in request.resource.data && request.resource.data.contactId == resource.data.contactId)) &&
          (!('createdByUid' in resource.data) || ('createdByUid' in request.resource.data && request.resource.data.createdByUid == resource.data.createdByUid)) &&
          (!('createdAt' in resource.data) || ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt));
        allow delete: if isAccountMember(accountId) &&
          !(('isEduSandbox' in request.auth.token) && request.auth.token.isEduSandbox == true) &&
          !isCallerEduRoleOrClassification() &&
          !isAccountEduSandbox(accountId);
      }

      // Subcolección Privada Multi-Tenant — Reglas de Facturación DTE, Recepción y Pago Ley N° 21.131 (OPERMAQ · PROVEEDORES, Ley N° 21.719)
      match /supplier_billing_rules/{supplierKey} {
        allow read: if isAccountMember(accountId);
        allow create, update: if isAccountMember(accountId) &&
          !(('isEduSandbox' in request.auth.token) && request.auth.token.isEduSandbox == true) &&
          !isCallerEduRoleOrClassification() &&
          !isAccountEduSandbox(accountId) &&
          isValidSupplierBillingRulePayload(request.resource.data, accountId, supplierKey);
        allow delete: if isAccountMember(accountId) &&
          !(('isEduSandbox' in request.auth.token) && request.auth.token.isEduSandbox == true) &&
          !isCallerEduRoleOrClassification() &&
          !isAccountEduSandbox(accountId);
      }
    }

    // Espejo administrativo de Tenants (Sin creación abierta a clientes)
    match /tenants/{tenantId} {
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isBoundedPayload(request.resource.data) && (
        isAdmin() ||
        (
          isAccountAdmin(tenantId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['company_name', 'updatedAt'])
        )
      );
    }

    match /edu_whitelists/{docId} {
      allow read, write: if isAdmin();
