            docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data) is string &&
            isAccountMember(docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data))
          )
        );
        allow create: if isAuthenticated() &&
          isBoundedPayload(request.resource.data) &&
          (
            isSystemPrivileged() ||
            (docTenantId(request.resource.data) is string && isAccountMember(docTenantId(request.resource.data))) ||
            (
              exists(/databases/$(database)/documents/inspections/$(inspectionId)) &&
              docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data) is string &&
              isAccountMember(docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data))
            )
          );
        allow update: if isAuthenticated() &&
          isBoundedPayload(request.resource.data) &&
          (
            isSystemPrivileged() ||
            (
              docTenantId(resource.data) is string &&
              isAccountMember(docTenantId(resource.data)) &&
              docTenantId(request.resource.data) == docTenantId(resource.data)
            ) ||
            (
              !('tenantId' in resource.data) &&
              !('tenant_id' in resource.data) &&
              !('accountId' in resource.data) &&
              !('tenantId' in request.resource.data) &&
              !('tenant_id' in request.resource.data) &&
              !('accountId' in request.resource.data) &&
              exists(/databases/$(database)/documents/inspections/$(inspectionId)) &&
              docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data) is string &&
              isAccountMember(docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data))
            )
          );
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          (docTenantId(resource.data) is string && isTenantAdminOrOwner(docTenantId(resource.data))) ||
          (
            !('tenantId' in resource.data) &&
            !('tenant_id' in resource.data) &&
            !('accountId' in resource.data) &&
            exists(/databases/$(database)/documents/inspections/$(inspectionId)) &&
            docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data) is string &&
            isTenantAdminOrOwner(docTenantId(get(/databases/$(database)/documents/inspections/$(inspectionId)).data))
          )
        );
      }
    }

    match /fleet_inspections/{inspectionId} {
