    }

    match /benchmark_insights/{insightId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /knowledge_contributions/{contribId} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        ('authorUid' in resource.data && resource.data.authorUid == request.auth.uid) ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isAuthenticated() &&
        isValidOpermaqPayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          (
            (!('authorUid' in request.resource.data) || request.resource.data.authorUid == null || request.resource.data.authorUid == request.auth.uid) &&
            (docTenantId(request.resource.data) == null || isAccountMember(docTenantId(request.resource.data))) &&
            (!('status' in request.resource.data) || request.resource.data.status == 'PENDING_HUMAN_REVIEW') &&
            (!('estado_aprobacion' in request.resource.data) || request.resource.data.estado_aprobacion == 'BORRADOR_IA')
          )
        );
      allow update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /media_registry/{sha256} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        ('scope' in resource.data && resource.data.scope in ['GLOBAL_OEM', 'SYMBOLOGY_MASTER']) ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() &&
          docTenantId(request.resource.data) is string &&
          isAccountMember(docTenantId(request.resource.data)) &&
          (!('scope' in request.resource.data) || request.resource.data.scope == 'TENANT_PRIVATE')
        )
      );
      allow update: if isValidOpermaqPayload(request.resource.data) && (
        isSystemPrivileged() ||
        (
          isAuthenticated() &&
          docTenantId(resource.data) is string &&
          isAccountMember(docTenantId(resource.data)) &&
          docTenantId(request.resource.data) == docTenantId(resource.data) &&
          (!('scope' in request.resource.data) || request.resource.data.scope == 'TENANT_PRIVATE')
        )
      );
      allow delete: if isAdmin();
    }

    match /commons_airlock_queue/{queueId} {
      allow read: if isAuthenticated() && (
        isSystemPrivileged() ||
        canReadTenantDoc(resource.data)
      );
      allow create: if isAuthenticated() &&
        isValidOpermaqPayload(request.resource.data) &&
        (
          isSystemPrivileged() ||
          (docTenantId(request.resource.data) is string && isAccountMember(docTenantId(request.resource.data)))
        );
      allow update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /global_material_catalog/{materialId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /symbology_review_queue/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isValidOpermaqPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    // ===============================================================
    // 9. Colecciones Legacy Blindadas (Lectura Auth, Escritura Privilegiada)
    // ===============================================================

    match /equipment_manuals/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /operational_guides/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /preventive_maintenance/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /risk_matrices/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /pre_operational_checklists/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    match /global_symbology/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isSystemPrivileged() && isBoundedPayload(request.resource.data);
      allow delete: if isSystemPrivileged();
    }

    // ===============================================================
    // 10. Default Deny Raíz (Cierre Total ISO 27001)
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
