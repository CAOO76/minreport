rules_version = '2';

// ===============================================================
// MINREPORT Web 3.0 — Seguridad Bancaria Multi-Tenant
// Jerarquía Soberana de 5 Tipos de Cuenta:
//   1º DEV          (isDevRoot)
//   2º ADMIN        (isSuperAdmin)
//   3º TEST-PILOT   (isTestPilot)
//   4º CLIENTES B2B (isAccountMember - Comercial / Industrial)
//   5º EDU          (isAccountMember - Académico)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: 1º Jerarquía Soberana — Verify if user is DEV_ROOT
    function isDevRoot() {
      return request.auth != null && 
        (
          request.auth.token.role == 'DEV_ROOT' ||
          request.auth.token.isMasterDev == true ||
          request.auth.token.email == 'dev@minreport.com' ||
          request.auth.uid == 'dev-master-root-uid'
        );
    }

    // Helper: 2º Jerarquía Soberana — Verify if user is Super Admin
    function isSuperAdmin() {
      return request.auth != null && 
        (
          request.auth.token.role == 'SUPER_ADMIN' ||
          request.auth.token.email == 'admin@minreport.com'
        );
    }

    // Helper: 3º Jerarquía Soberana — Verify if user is TEST-PILOT
    function isTestPilot() {
      return request.auth != null && (
        request.auth.token.role == 'TEST_PILOT' ||
        request.auth.token.role == 'PILOT_LEAD' ||
        request.auth.token.classification == 'test-pilot'
      );
    }

    // Helper: 4º y 5º Jerarquía Soberana — Check if user belongs to an account (B2B / EDU)
    function isAccountMember(accountId) {
      return request.auth != null && (
        isSuperAdmin() ||
        isDevRoot() ||
        isTestPilot() ||
        accountId == 'faena-minreport' ||
        request.auth.token.activeAccountId == accountId ||
        (accountId != null && exists(/databases/$(database)/documents/accounts/$(accountId)/members/$(request.auth.uid))) ||
        (accountId != null && get(/databases/$(database)/documents/accounts/$(accountId)).data.ownerId == request.auth.uid)
      );
    }

    // SEGURIDAD BANCARIA: Directorio de identificación RUT
    match /user_directory/{run} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin() || isDevRoot();
    }

    // Perfiles de usuario
    match /users/{userId} {
      // Blindaje de cuenta maestra DEV
      allow read, write: if userId == 'dev-master-root-uid' ? isDevRoot() : (isSuperAdmin() || isDevRoot());
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.query.limit != null && request.query.limit <= 1;
      allow update: if request.auth != null && request.auth.uid == userId && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAccountId', 'memberships', 'notificationsSettings']);
      // Prohibición absoluta de purga para cuentas protegidas de sistema
      allow delete: if isSuperAdmin() && userId != 'dev-master-root-uid' && userId != 'super-admin-uid';
    }

    // CUENTAS Y ESPACIOS DE TRABAJO TITULARES (Web 3.0)
    match /accounts/{accountId} {
      allow get: if isAccountMember(accountId);
      allow list: if request.auth != null && (
        isSuperAdmin() || 
        isDevRoot() ||
        isTestPilot() ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.primaryOperator != null && resource.data.primaryOperator.email == request.auth.token.email)
      );
      allow create: if request.auth != null;
      // Prohibido eliminar el sandbox maestro DEV
      allow delete: if isSuperAdmin() && accountId != 'dev-master-sandbox';
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        isDevRoot() ||
        (resource.data.ownerId == request.auth.uid) ||
        (request.auth.token.activeAccountId == accountId)
      );

      // Subcolección: Perfiles de Cargo (Job Profiles)
      match /job_profiles/{profileId} {
        allow read, write: if isAccountMember(accountId);
      }

      // Subcolección: Miembros Internos
      match /members/{memberId} {
        // En cuentas EDU, prohibido agregar más miembros si la cuenta tiene allowInternalUsers == false
        allow read, write: if isAccountMember(accountId);
      }
    }

    // [DEV_ROOT] REGISTRO SEGREGADO DE CUENTAS TEST-PILOT (Colaboradores)
    match /test_pilots/{pilotId} {
      allow read: if isDevRoot() || isSuperAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.collaboratorEmail == request.auth.token.email));
      allow write: if isDevRoot() || isSuperAdmin();
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telemetry', 'lastActivity']);
    }

    // [TEST-PILOT] RETROALIMENTACIÓN, SOLICITUDES DE CAMBIO Y ENTRENAMIENTO IA
    match /pilot_feedback/{feedbackId} {
      allow read: if isDevRoot() || isSuperAdmin() || isTestPilot() || (request.auth != null && resource.data.authorUid == request.auth.uid);
      allow create: if isDevRoot() || isSuperAdmin() || isTestPilot() || request.auth != null;
      allow update, delete: if isDevRoot() || isSuperAdmin();
    }

    // [CAPA 3] AUDIT LEDGER INMUTABLE (Append-Only)
    match /audit_ledger/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isAccountMember(resource.data.tenantId);
      allow update, delete: if false; // Inmutable
    }

    // [CAPA 4] CACHÉ SHA-256 DE INFERENCIA ENJAMBRE GEMINI IA
    match /ai_inference_cache/{cacheKey} {
      allow read: if request.auth != null;
      allow write: if isDevRoot() || isSuperAdmin();
    }

    // [OPERMAQ] Flota, Catálogo Maestro y Bóvedas de Conocimiento
    match /global_asset_catalog/{assetId} {
      allow read: if request.auth != null;
      allow write: if isDevRoot() || isSuperAdmin() || isTestPilot();
    }

    match /tenant_assets/{assetId} {
      allow read: if request.auth != null && (resource.data.tenantId == null || resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(resource.data.tenantId));
      allow create: if request.auth != null && (request.resource.data.tenantId == null || request.resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(request.resource.data.tenantId));
      allow update, delete: if request.auth != null && (resource.data.tenantId == null || resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(resource.data.tenantId));
    }

    match /master_symbology_vault/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin() || isDevRoot() || isTestPilot();
    }

    match /hitl_candidates/{candidateId} {
      allow read: if request.auth != null;
      allow write: if isDevRoot() || isSuperAdmin() || isTestPilot() || (request.auth != null && (request.resource.data.tenantId == null || isAccountMember(request.resource.data.tenantId)));
    }

    match /event_ledger/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // Inmutable
    }

    match /machinery_fleet/{assetId} {
      allow read, delete: if request.auth != null && (resource.data.tenantId == null || resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(resource.data.tenantId));
      allow create, update: if request.auth != null && (request.resource.data.tenantId == null || request.resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(request.resource.data.tenantId));
    }

    match /inspections/{inspectionId} {
      allow read, delete: if request.auth != null && (resource.data.tenantId == null || resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(resource.data.tenantId));
      allow create, update: if request.auth != null && (request.resource.data.tenantId == null || request.resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(request.resource.data.tenantId));
    }

    match /fleet_inspections/{inspectionId} {
      allow read, delete: if request.auth != null && (resource.data.tenantId == null || resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(resource.data.tenantId));
      allow create, update: if request.auth != null && (request.resource.data.tenantId == null || request.resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(request.resource.data.tenantId));
    }

    // [STOCKPILE] Acopios Topográficos y Volumetría
    match /stockpiles/{stkId} {
      allow read, delete: if request.auth != null && (resource.data.tenantId == null || resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(resource.data.tenantId));
      allow create, update: if request.auth != null && (request.resource.data.tenantId == null || request.resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(request.resource.data.tenantId));
    }

    // [MINING FLOW] Eventos Financieros y Flujo de Caja
    match /financial_events/{eventId} {
      allow read, delete: if request.auth != null && (resource.data.tenantId == null || resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(resource.data.tenantId));
      allow create, update: if request.auth != null && (request.resource.data.tenantId == null || request.resource.data.tenantId == 'faena-minreport' || isTestPilot() || isAccountMember(request.resource.data.tenantId));
    }

    match /financial_ledger/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // Inmutable
    }

    // Configuración Global y Branding
    match /settings/branding {
      allow read: if true;
      allow write: if isSuperAdmin() || isDevRoot();
    }

    match /system/brand_config {
      allow read: if true;
      allow write: if isSuperAdmin() || isDevRoot();
    }

    // Solicitudes y Tenants
    match /tenants/{tenantId} {
      allow read, write: if isSuperAdmin() || isDevRoot();
      allow create: if request.auth != null;
    }

    match /edu_whitelists/{docId} {
      allow read, write: if isSuperAdmin() || isDevRoot();
    }

    // Mensajería y Notificaciones
    match /users/{userId}/inbox/{messageId} {
      allow read, write: if isSuperAdmin() || isDevRoot() || (request.auth != null && request.auth.uid == userId);
    }

    // Módulos Nativos y Catálogo de Disponibilidad
    match /modules_status/{moduleId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isDevRoot();
    }
  }
}
