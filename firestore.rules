    // ===============================================================

    match /global_asset_catalog/{assetId} {
      allow read: if isAuthenticated();
      // Segregación estricta GEMINI.md §1.1: 2º ADMIN solo lectura comercial; 3º TEST-PILOT hermético sin curación de catálogo maestro; mutación cliente OEM exclusiva 1º DEV
