{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "minreport-web",
      "public": "web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(self), geolocation=(self), microphone=()"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|woff|woff2|svg|webp|png)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "minreport-api",
            "region": "southamerica-west1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "codebase": "default",
      "region": "southamerica-west1",
      "source": "services/functions",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9190,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8085,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 9196,
      "host": "0.0.0.0"
    },
    "hosting": {
      "port": 5010,
      "host": "0.0.0.0"
    },
    "storage": {
      "port": 9195,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4002,
      "host": "0.0.0.0"
    }
  }
}
