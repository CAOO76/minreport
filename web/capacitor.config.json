{
    "appId": "com.minreport.app",
    "appName": "MinReport",
    "webDir": "dist",
    "server": {
        "androidScheme": "http",
        "url": "http://192.168.1.85:5173",
        "cleartext": true,
        "allowNavigation": [
            "localhost",
            "localhost:*",
            "192.168.1.*",
            "10.0.2.2",
            "10.0.2.2:*"
        ]
    },
    "plugins": {
        "Camera": {
            "permissions": [
                "camera",
                "photos"
            ]
        },
        "Geolocation": {
            "permissions": [
                "location"
            ]
        }
    }
}