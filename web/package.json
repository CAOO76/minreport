{
  "name": "minreport-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "BROWSERSLIST_IGNORE_OLD_DATA=true vite --host",
    "dev:mobile": "bash scripts/dev-mobile.sh",
    "clean:android": "bash scripts/clean-android.sh",
    "build:apk": "bash scripts/build-apk.sh",
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=true vite build",
    "preview": "vite preview --host",
    "android": "npx cap run android -l",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "assets:generate": "npx @capacitor/assets generate --android --assetPath assets",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/motion": "^6.0.2",
    "@capacitor/network": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@types/three": "^0.186.0",
    "baseline-browser-mapping": "^2.11.26",
    "caniuse-lite": "^1.0.30001814",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "firebase": "^10.14.1",
    "framer-motion": "^12.29.0",
    "html-to-image": "^1.11.13",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.1",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1",
    "three": "^0.186.1",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vitest": "^4.1.0"
  }
}
