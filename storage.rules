rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDevRoot() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'DEV_ROOT') ||
        ('isMasterDev' in request.auth.token && request.auth.token.isMasterDev == true) ||
        request.auth.uid == 'dev-master-root-uid' ||
        (
          'email' in request.auth.token &&
          request.auth.token.email == 'dev@minreport.com' &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true
        )
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        request.auth.uid == 'super-admin-uid' ||
        (
          'email' in request.auth.token &&
          request.auth.token.email == 'admin@minreport.com' &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true
        )
      );
    }

    // Fail-closed: soporta timestamp Firestore y epoch ms (int/float); cualquier otro tipo no nulo retorna false
    function isNotExpiredValue(val) {
      return val == null ||
        (val is timestamp && request.time < val) ||
        ((val is int || val is float) && request.time.toMillis() < val);
    }

    function hasValidPilotTokenExpiry() {
      return !('pilotExpiresAt' in request.auth.token) ||
        isNotExpiredValue(request.auth.token.pilotExpiresAt);
    }

    function isValidPilotRecord(pilotData) {
      return pilotData != null &&
        (!('status' in pilotData) || pilotData.status == 'ACTIVE') &&
        (!('expiresAt' in pilotData) || isNotExpiredValue(pilotData.expiresAt)) &&
        (!('pilotExpiresAt' in pilotData) || isNotExpiredValue(pilotData.pilotExpiresAt));
    }

    function isActiveMemberRecord(m) {
      return m != null && (!('status' in m) || m.status == 'ACTIVE');
    }

    function isActiveMemberDoc(tenantId) {
      return firestore.exists(/databases/(default)/documents/accounts/$(tenantId)/members/$(request.auth.uid)) &&
        isActiveMemberRecord(firestore.get(/databases/(default)/documents/accounts/$(tenantId)/members/$(request.auth.uid)).data);
    }

    // Bloquea miembros SUSPENDED/REVOKED aunque el JWT aún conserve activeAccountId/tenantId
    function isNotSuspendedOrRevokedMember(tenantId) {
      return !firestore.exists(/databases/(default)/documents/accounts/$(tenantId)/members/$(request.auth.uid)) ||
        isActiveMemberRecord(firestore.get(/databases/(default)/documents/accounts/$(tenantId)/members/$(request.auth.uid)).data);
    }

    // Esquema real dev.controller.ts: /test_pilots/{pilotAccountId} con userId == request.auth.uid
    function matchesPilotDocByAccountId(tenantId) {
      return tenantId is string &&
        tenantId.matches('^pilot-.*') &&
        firestore.exists(/databases/(default)/documents/test_pilots/$(tenantId)) &&
        'userId' in firestore.get(/databases/(default)/documents/test_pilots/$(tenantId)).data &&
        firestore.get(/databases/(default)/documents/test_pilots/$(tenantId)).data.userId == request.auth.uid &&
        isValidPilotRecord(firestore.get(/databases/(default)/documents/test_pilots/$(tenantId)).data);
    }

    // Esquema directo /test_pilots/{uid} con sandbox pilot-{uid}, pilotAccountId o accountId
    function matchesPilotDocByUid(tenantId) {
      return tenantId is string &&
        tenantId.matches('^pilot-.*') &&
        firestore.exists(/databases/(default)/documents/test_pilots/$(request.auth.uid)) &&
        isValidPilotRecord(firestore.get(/databases/(default)/documents/test_pilots/$(request.auth.uid)).data) && (
          tenantId == ('pilot-' + request.auth.uid) ||
          (
            'pilotAccountId' in firestore.get(/databases/(default)/documents/test_pilots/$(request.auth.uid)).data &&
            firestore.get(/databases/(default)/documents/test_pilots/$(request.auth.uid)).data.pilotAccountId == tenantId
          ) ||
          (
            'accountId' in firestore.get(/databases/(default)/documents/test_pilots/$(request.auth.uid)).data &&
            firestore.get(/databases/(default)/documents/test_pilots/$(request.auth.uid)).data.accountId == tenantId
          )
        );
    }

    function isTestPilot() {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'TEST_PILOT' &&
        hasValidPilotTokenExpiry() && (
          (
            firestore.exists(/databases/(default)/documents/test_pilots/$(request.auth.uid)) &&
            isValidPilotRecord(firestore.get(/databases/(default)/documents/test_pilots/$(request.auth.uid)).data)
          ) ||
          (
            'activeAccountId' in request.auth.token &&
            matchesPilotDocByAccountId(request.auth.token.activeAccountId)
          )
        );
    }

    function isTestPilotToken() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'TEST_PILOT') ||
        ('pilotExpiresAt' in request.auth.token)
      );
    }

    function isTestPilotOwnSandbox(tenantId) {
      return isAuthenticated() &&
        'role' in request.auth.token &&
        request.auth.token.role == 'TEST_PILOT' &&
        hasValidPilotTokenExpiry() &&
        tenantId is string &&
        tenantId.matches('^pilot-.*') &&
        isNotSuspendedOrRevokedMember(tenantId) && (
          matchesPilotDocByAccountId(tenantId) ||
          matchesPilotDocByUid(tenantId)
        );
    }

    function isAdmin() {
      return isDevRoot() || isSuperAdmin();
    }

    function isSystemPrivileged() {
      return isDevRoot() || isSuperAdmin();
    }

    function hasTenantTokenClaim(tenantId) {
      return (
        ('activeAccountId' in request.auth.token && request.auth.token.activeAccountId == tenantId) ||
        ('tenantId' in request.auth.token && request.auth.token.tenantId == tenantId)
      );
    }

    function isAccountOwner(tenantId) {
      return firestore.exists(/databases/(default)/documents/accounts/$(tenantId)) &&
        'ownerId' in firestore.get(/databases/(default)/documents/accounts/$(tenantId)).data &&
        firestore.get(/databases/(default)/documents/accounts/$(tenantId)).data.ownerId == request.auth.uid;
    }

    function isTenantMemberOrAdmin(tenantId) {
      return isAuthenticated() &&
        tenantId is string &&
        tenantId.size() > 0 && (
          isAdmin() ||
          isTestPilotOwnSandbox(tenantId) ||
          (
            !isTestPilotToken() &&
            isNotSuspendedOrRevokedMember(tenantId) && (
              hasTenantTokenClaim(tenantId) ||
              isActiveMemberDoc(tenantId) ||
              isAccountOwner(tenantId)
            )
          )
        );
    }

    function isTenantAuthorized(tenantId) {
      return isAuthenticated() &&
        tenantId is string &&
        tenantId.size() > 0 && (
          isSystemPrivileged() ||
          isTestPilotOwnSandbox(tenantId) ||
          (
            !isTestPilotToken() &&
            isNotSuspendedOrRevokedMember(tenantId) && (
              hasTenantTokenClaim(tenantId) ||
              isActiveMemberDoc(tenantId) ||
              isAccountOwner(tenantId)
            )
          )
        );
    }

    function isAllowedTechnicalMedia() {
      return request.resource != null &&
        request.resource.contentType != null && (
          request.resource.contentType.matches('image/(webp|png|jpeg|svg\\+xml)') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType.matches('video/(mp4|webm)') ||
          request.resource.contentType == 'model/gltf-binary' ||
          request.resource.contentType == 'application/octet-stream' ||
          request.resource.contentType == 'text/html'
        );
    }

    // Activos públicos de marca corporativa (solo lectura pública, escritura exclusiva DEV/ADMIN)
    match /branding/{allPaths=**} {
      allow read: if true;
      allow delete: if isDevRoot() || isSuperAdmin();
      allow create, update: if (isDevRoot() || isSuperAdmin()) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(webp|png|jpeg|svg\\+xml|x-icon|vnd\\.microsoft\\.icon)');
    }

    // Manuales técnicos compilados y corpus OEM global (escritura exclusiva curadores acreditados)
    match /manuals/{allPaths=**} {
      allow read: if isAuthenticated();
      allow delete: if isSystemPrivileged();
      allow create, update: if isSystemPrivileged() &&
        request.resource.size < 80 * 1024 * 1024 &&
        isAllowedTechnicalMedia();
    }

    // CAS SHA-256 — Activos Globales OEM Verificados (ingesta exclusiva vía servidor CAS)
    match /cas_blobs/global_oem/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // CAS SHA-256 — Simbología Industrial Vectorial Maestra (ingesta exclusiva vía servidor CAS)
    match /cas_blobs/symbology/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // CAS SHA-256 — Bóveda Privada Aislada por Tenant (auditoría DEV/ADMIN + titular; cero escritura directa cliente)
    match /cas_blobs/tenants/{tenantId}/{allPaths=**} {
      allow read: if isTenantMemberOrAdmin(tenantId);
      allow write: if false;
    }

    // CAS SHA-256 — Cobertura de auditoría soberana DEV/ADMIN y bloqueo total de escritura directa en subrutas CAS
    match /cas_blobs/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Bóveda Vectorial Pública de Simbología Industrial (SVG/WebP inmutable)
    match /assets/symbology/{allPaths=**} {
      allow read: if true;
      allow delete: if isDevRoot() || isSuperAdmin();
      allow create, update: if isSystemPrivileged() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(svg\\+xml|webp|png)');
    }

    // Evidencia fotogramétrica, mallas 3D (.glb) e imágenes WebP aisladas por Tenant
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isTenantAuthorized(tenantId);
      allow delete: if isTenantAuthorized(tenantId);
      allow create, update: if isTenantAuthorized(tenantId) &&
        request.resource.size < 50 * 1024 * 1024 &&
        isAllowedTechnicalMedia();
    }

    // Denegación explícita por defecto sobre cualquier ruta no gobernada (Cero comodines OR)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
